---
// src/components/sections/Thesis.astro
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props {
  eyebrow: string;
  quote: string;
  attribution?: string;
}
const { eyebrow, quote, attribution } = Astro.props;
---

<section class="max-w-6xl mx-auto px-6 py-16">
  <Eyebrow>{eyebrow}</Eyebrow>
  <blockquote
    class="mt-5 text-2xl md:text-3xl font-medium tracking-[-0.012em] leading-[1.3] text-[var(--color-ink)] max-w-[40ch]"
  >
    {quote}
  </blockquote>
  {attribution && <p class="mt-4 text-xs text-slate-500 font-medium">{attribution}</p>}
</section>
