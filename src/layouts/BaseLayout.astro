---
// src/layouts/BaseLayout.astro
import '@/styles/global.css';
import Nav from '@/components/layout/Nav.astro';
import Footer from '@/components/layout/Footer.astro';
import Seo from '@/components/layout/Seo.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  preloadImage?: string;
  preloadImageType?: string;
}
const { title, description, ogImage, canonical, preloadImage, preloadImageType } = Astro.props;

const cfBeaconToken = 'REPLACE_WITH_CF_BEACON_TOKEN';
const beaconEnabled = import.meta.env.PROD && !cfBeaconToken.startsWith('REPLACE_');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          type={preloadImageType}
          fetchpriority="high"
        />
      )
    }
    <Seo title={title} description={description} ogImage={ogImage} canonical={canonical} />
    {
      beaconEnabled && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token":"${cfBeaconToken}"}`}
        />
      )
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-[var(--color-ink)] focus:text-[var(--color-cream)] focus:p-2 focus:rounded"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
