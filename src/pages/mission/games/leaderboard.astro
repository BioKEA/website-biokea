---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import {
  LEADERBOARD_GAMES,
  KNOWN_HANDLE_KEYS,
  SUPABASE_URL,
  SUPABASE_PUBLISHABLE_KEY,
} from '@/data/leaderboard-games';
---

<BaseLayout
  title="Leaderboard — BioKEA Games"
  description="Daily, season, and cross-game BioKEA Points (BKP) standings across the six BioKEA games."
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <Eyebrow>STORYTELLING · LEADERBOARD</Eyebrow>
    <div class="mt-3 grid lg:grid-cols-[minmax(0,52ch)_minmax(0,1fr)] gap-x-10 gap-y-6 items-start">
      <div>
        <h1
          class="text-4xl md:text-5xl font-semibold tracking-[-0.025em] leading-[1.05] text-[var(--color-ink)]"
        >
          BioKEA Game Leaderboard
        </h1>
        <p class="mt-5 text-slate-600 leading-relaxed">
          Each daily seed earns <strong>BioKEA Points</strong> (BKP) by rank: <span
            class="font-mono text-[12px] tracking-tight"
            >#1 → 25 · top 3 → 15 · top 10 → 10 · any submission → 5</span
          >. Sum across the six games and across the days of the month for the season ranking.
        </p>
      </div>

      <aside
        class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md p-4"
        data-handle-finder
      >
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ochre)]">
          Find me
        </div>
        <p class="mt-1 text-[12px] text-slate-600 leading-snug">
          Type the handle you use in the games to highlight your rows.
        </p>
        <div class="mt-3 flex gap-2">
          <input
            type="text"
            data-handle-input
            placeholder="handle"
            maxlength="32"
            class="flex-1 border border-slate-900/15 rounded-sm px-3 py-2 bg-white/90 text-[var(--color-ink)] text-sm font-mono"
          />
          <button
            type="button"
            data-handle-set
            class="bg-[var(--color-ink)] text-[var(--color-cream)] px-3 py-2 rounded-sm font-semibold text-xs uppercase tracking-[0.08em]"
          >
            Set
          </button>
        </div>
      </aside>
    </div>
  </section>

  <!-- Tab nav -->
  <section
    class="max-w-5xl mx-auto px-6 sticky top-0 z-30 bg-[var(--color-cream)]/95 backdrop-blur"
  >
    <div role="tablist" class="flex gap-1 border-b border-slate-900/15">
      <button
        type="button"
        role="tab"
        data-tab="today"
        class="px-4 py-3 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 border-b-2 border-transparent transition data-[active=true]:text-[var(--color-ink)] data-[active=true]:border-[var(--color-ink)]"
        data-active="true"
      >
        Today
      </button>
      <button
        type="button"
        role="tab"
        data-tab="season"
        class="px-4 py-3 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 border-b-2 border-transparent transition data-[active=true]:text-[var(--color-ink)] data-[active=true]:border-[var(--color-ink)]"
      >
        Season
      </button>
      <button
        type="button"
        role="tab"
        data-tab="champions"
        class="px-4 py-3 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 border-b-2 border-transparent transition data-[active=true]:text-[var(--color-ink)] data-[active=true]:border-[var(--color-ink)]"
      >
        Champions
      </button>
    </div>
  </section>

  <!-- Today panel -->
  <section
    class="max-w-5xl mx-auto px-6 py-10 hidden data-[active=true]:block"
    data-panel="today"
    data-active="true"
  >
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">
        Today's Champions
      </h2>
      <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-slate-500" data-today-date
        >—</span
      >
    </div>

    <div
      class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden mb-10"
    >
      <table class="w-full text-sm">
        <thead class="bg-[var(--color-ink)] text-[var(--color-cream)]">
          <tr class="font-mono text-[10px] tracking-[0.18em] uppercase">
            <th class="px-4 py-3 text-left w-12">#</th>
            <th class="px-4 py-3 text-left">Player</th>
            <th class="px-4 py-3 text-right">BKP</th>
            <th class="px-4 py-3 text-right hidden sm:table-cell">Games</th>
            <th class="px-4 py-3 text-right hidden sm:table-cell">Golds</th>
          </tr>
        </thead>
        <tbody data-today-cross>
          <tr><td class="px-4 py-6 text-center text-slate-400 italic" colspan="5">loading…</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-lg font-semibold text-[var(--color-ink)] mb-4">Per-game leaders today</h3>
    <div class="grid md:grid-cols-2 gap-4" data-today-per-game>
      <!-- Per-game blocks injected by JS -->
    </div>
  </section>

  <!-- Season panel -->
  <section class="max-w-5xl mx-auto px-6 py-10 hidden data-[active=true]:block" data-panel="season">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">
        Season top scores
      </h2>
      <span
        class="font-mono text-[11px] tracking-[0.14em] uppercase text-slate-500"
        data-season-month>—</span
      >
    </div>
    <p class="text-sm text-slate-600 leading-relaxed mb-6">
      Best score per player per game in the current month — daily, custom and seasonal modes
      collapse to one personal best per game per day, ranked across the season.
    </p>
    <div class="grid md:grid-cols-2 gap-4" data-season-per-game></div>
  </section>

  <!-- Champions panel -->
  <section
    class="max-w-5xl mx-auto px-6 py-10 hidden data-[active=true]:block"
    data-panel="champions"
  >
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">
        Season Champions
      </h2>
      <span
        class="font-mono text-[11px] tracking-[0.14em] uppercase text-slate-500"
        data-champions-month>—</span
      >
    </div>
    <p class="text-sm text-slate-600 leading-relaxed mb-6">
      Cumulative BKP across all six games for the current month. Verified players (
      <span class="text-[var(--color-teal)]">✓</span>
      ) have an active subscription tied to their handle.
    </p>
    <div class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-[var(--color-ink)] text-[var(--color-cream)]">
          <tr class="font-mono text-[10px] tracking-[0.18em] uppercase">
            <th class="px-4 py-3 text-left w-12">#</th>
            <th class="px-4 py-3 text-left">Player</th>
            <th class="px-4 py-3 text-right">BKP</th>
            <th class="px-4 py-3 text-right hidden sm:table-cell">Days</th>
            <th class="px-4 py-3 text-right hidden sm:table-cell">Games</th>
            <th class="px-4 py-3 text-right hidden sm:table-cell">Golds</th>
          </tr>
        </thead>
        <tbody data-champions-rows>
          <tr><td class="px-4 py-6 text-center text-slate-400 italic" colspan="6">loading…</td></tr>
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-xs text-slate-500 italic" data-champions-rank></p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-12">
    <a
      href="/mission/games/"
      class="inline-flex items-center gap-2 font-mono-label text-[var(--color-ochre)] hover:text-[var(--color-teal)]"
    >
      ← Back to all games
    </a>
  </section>

  <script
    is:inline
    define:vars={{
      supabaseUrl: SUPABASE_URL,
      supabaseKey: SUPABASE_PUBLISHABLE_KEY,
      games: LEADERBOARD_GAMES,
      handleKeys: KNOWN_HANDLE_KEYS,
    }}
  >
    (() => {
      const HANDLE_STORAGE_KEY = 'biokea:leaderboard:handle';

      const escapeHtml = (s) =>
        String(s).replace(
          /[&<>"']/g,
          (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
        );

      const fmtScore = (score, unit) => {
        if (unit === 'sec') {
          const m = Math.floor(score / 60);
          const r = Math.floor(score % 60);
          return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
        }
        return Number(score).toLocaleString();
      };

      const todayKey = () => {
        const d = new Date();
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
      };

      const startOfMonth = () => {
        const d = new Date();
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        return `${y}-${m}-01`;
      };

      const monthLabel = () =>
        new Date().toLocaleDateString(undefined, { month: 'long', year: 'numeric' });

      const supaFetch = (path) =>
        fetch(`${supabaseUrl}/rest/v1/${path}`, {
          headers: { apikey: supabaseKey, Authorization: `Bearer ${supabaseKey}` },
        }).then((r) => (r.ok ? r.json() : []));

      // ─── handle finder ───
      function getStoredHandle() {
        try {
          const direct = localStorage.getItem(HANDLE_STORAGE_KEY);
          if (direct) return direct;
          for (const k of handleKeys) {
            const v = localStorage.getItem(k);
            if (v && v.trim().length > 0) return v.trim();
          }
        } catch {}
        return null;
      }

      function setStoredHandle(handle) {
        try {
          localStorage.setItem(HANDLE_STORAGE_KEY, handle);
        } catch {}
      }

      let myHandle = getStoredHandle();
      const handleInput = document.querySelector('[data-handle-input]');
      const handleSet = document.querySelector('[data-handle-set]');
      if (handleInput && myHandle) handleInput.value = myHandle;
      if (handleSet) {
        handleSet.addEventListener('click', () => {
          const v = (handleInput?.value ?? '').trim();
          if (!v) return;
          myHandle = v;
          setStoredHandle(v);
          // Re-render whichever panel is active.
          const active = document.querySelector('[data-panel][data-active="true"]');
          const tab = active?.getAttribute('data-panel');
          if (tab === 'today') void loadToday();
          else if (tab === 'season') void loadSeason();
          else if (tab === 'champions') void loadChampions();
        });
      }

      // ─── tab switching ───
      const tabBtns = document.querySelectorAll('[data-tab]');
      const panels = document.querySelectorAll('[data-panel]');
      const loaded = { today: false, season: false, champions: false };
      function activate(tabName) {
        tabBtns.forEach((b) =>
          b.setAttribute('data-active', b.getAttribute('data-tab') === tabName ? 'true' : 'false'),
        );
        panels.forEach((p) =>
          p.setAttribute(
            'data-active',
            p.getAttribute('data-panel') === tabName ? 'true' : 'false',
          ),
        );
        if (tabName === 'today' && !loaded.today) {
          loaded.today = true;
          void loadToday();
        } else if (tabName === 'season' && !loaded.season) {
          loaded.season = true;
          void loadSeason();
        } else if (tabName === 'champions' && !loaded.champions) {
          loaded.champions = true;
          void loadChampions();
        }
      }
      tabBtns.forEach((b) =>
        b.addEventListener('click', () => activate(b.getAttribute('data-tab'))),
      );

      const isMine = (handle) =>
        myHandle && handle && handle.toLowerCase() === myHandle.toLowerCase();

      const verifiedBadge = (verified) =>
        verified
          ? '<span class="inline-block align-middle ml-1 text-[var(--color-teal)] text-[11px]" title="Verified subscriber">✓</span>'
          : '';

      // ─── Today ───
      async function loadToday() {
        const day = todayKey();
        const dateEl = document.querySelector('[data-today-date]');
        if (dateEl) dateEl.textContent = day;

        // Cross-game daily standings
        const standings = await supaFetch(
          `daily_standings?day=eq.${day}&order=bkp_total.desc,golds.desc&limit=20`,
        );
        const tbody = document.querySelector('[data-today-cross]');
        if (tbody) {
          if (standings.length === 0) {
            tbody.innerHTML =
              '<tr><td class="px-4 py-6 text-center text-slate-400 italic" colspan="5">No scores posted today yet. Be first.</td></tr>';
          } else {
            tbody.innerHTML = standings
              .map((r, i) => {
                const mine = isMine(r.player_handle);
                return `<tr class="${mine ? 'bg-[var(--color-ochre)]/10' : i % 2 ? 'bg-white/40' : ''} border-t border-slate-900/5">
                  <td class="px-4 py-2 font-mono text-[12px] text-slate-500">${i + 1}</td>
                  <td class="px-4 py-2 ${mine ? 'font-semibold text-[var(--color-ink)]' : 'text-[var(--color-ink)]'}">${escapeHtml(r.player_handle)}${verifiedBadge(r.verified)}${mine ? ' <span class="font-mono text-[9px] tracking-[0.16em] uppercase text-[var(--color-ochre)] ml-1">you</span>' : ''}</td>
                  <td class="px-4 py-2 text-right font-mono">${r.bkp_total}</td>
                  <td class="px-4 py-2 text-right font-mono text-[12px] text-slate-500 hidden sm:table-cell">${r.games_played}</td>
                  <td class="px-4 py-2 text-right font-mono text-[12px] text-slate-500 hidden sm:table-cell">${r.golds}</td>
                </tr>`;
              })
              .join('');
          }
        }

        // Per-game today (top 5 per game)
        const grid = document.querySelector('[data-today-per-game]');
        if (grid) {
          grid.innerHTML = games
            .map(
              (g) => `
                <div class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden" data-today-game="${g.id}">
                  <div class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2 flex items-baseline justify-between">
                    <a href="${g.playUrl}" class="text-sm font-semibold hover:text-[var(--color-ochre)]">${escapeHtml(g.title)}</a>
                    <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[var(--color-cream)]/60">${g.unit === 'sec' ? 'time' : 'pts'}</span>
                  </div>
                  <ol class="divide-y divide-slate-900/5" data-rows>
                    <li class="px-4 py-3 text-[12px] font-mono text-slate-400 italic">loading…</li>
                  </ol>
                </div>`,
            )
            .join('');

          // Fill each block in parallel
          await Promise.all(
            games.map(async (g) => {
              const rows = await supaFetch(
                `scores_with_bkp?game_id=eq.${g.id}&seed=eq.${day}&order=rank.asc&limit=5`,
              );
              const block = grid.querySelector(`[data-today-game="${g.id}"] [data-rows]`);
              if (!block) return;
              if (rows.length === 0) {
                block.innerHTML =
                  '<li class="px-4 py-3 text-[11px] font-mono text-slate-400 italic">no scores yet</li>';
                return;
              }
              block.innerHTML = rows
                .map((r) => {
                  const mine = isMine(r.player_handle);
                  return `<li class="px-4 py-2 flex items-baseline justify-between gap-3 ${mine ? 'bg-[var(--color-ochre)]/10' : ''}">
                    <div class="flex items-baseline gap-2 min-w-0">
                      <span class="font-mono text-[10px] text-slate-400 w-4 text-right">${r.rank}</span>
                      <span class="text-sm truncate ${mine ? 'font-semibold' : ''} text-[var(--color-ink)]">${escapeHtml(r.player_handle)}${verifiedBadge(r.verified)}</span>
                    </div>
                    <div class="flex items-baseline gap-2 shrink-0">
                      <span class="font-mono text-[12px] text-[var(--color-ink)]">${fmtScore(r.score, g.unit)}</span>
                      <span class="font-mono text-[10px] tracking-[0.08em] uppercase text-[var(--color-ochre)]">+${r.bkp}</span>
                    </div>
                  </li>`;
                })
                .join('');
            }),
          );
        }
      }

      // ─── Season (per-game) ───
      async function loadSeason() {
        const monthStart = startOfMonth();
        const monthEl = document.querySelector('[data-season-month]');
        if (monthEl) monthEl.textContent = monthLabel();

        const grid = document.querySelector('[data-season-per-game]');
        if (!grid) return;
        grid.innerHTML = games
          .map(
            (g) => `
              <div class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden" data-season-game="${g.id}">
                <div class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2 flex items-baseline justify-between">
                  <a href="${g.playUrl}" class="text-sm font-semibold hover:text-[var(--color-ochre)]">${escapeHtml(g.title)}</a>
                  <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[var(--color-cream)]/60">season top</span>
                </div>
                <ol class="divide-y divide-slate-900/5" data-rows>
                  <li class="px-4 py-3 text-[12px] font-mono text-slate-400 italic">loading…</li>
                </ol>
              </div>`,
          )
          .join('');

        await Promise.all(
          games.map(async (g) => {
            // scores_best_daily already collapses to one row per (player, day, game)
            const rows = await supaFetch(
              `scores_best_daily?game_id=eq.${g.id}&mode=eq.${encodeURIComponent(g.mode)}&seed=gte.${monthStart}&order=score.desc&limit=10`,
            );
            const block = grid.querySelector(`[data-season-game="${g.id}"] [data-rows]`);
            if (!block) return;
            if (rows.length === 0) {
              block.innerHTML =
                '<li class="px-4 py-3 text-[11px] font-mono text-slate-400 italic">no scores yet this season</li>';
              return;
            }
            block.innerHTML = rows
              .map((r, i) => {
                const mine = isMine(r.player_handle);
                return `<li class="px-4 py-2 flex items-baseline justify-between gap-3 ${mine ? 'bg-[var(--color-ochre)]/10' : ''}">
                  <div class="flex items-baseline gap-2 min-w-0">
                    <span class="font-mono text-[10px] text-slate-400 w-4 text-right">${i + 1}</span>
                    <span class="text-sm truncate ${mine ? 'font-semibold' : ''} text-[var(--color-ink)]">${escapeHtml(r.player_handle)}</span>
                  </div>
                  <div class="flex items-baseline gap-2 shrink-0">
                    <span class="font-mono text-[12px] text-[var(--color-ink)]">${fmtScore(r.score, g.unit)}</span>
                    <span class="font-mono text-[10px] text-slate-500">${(r.seed || '').slice(5)}</span>
                  </div>
                </li>`;
              })
              .join('');
          }),
        );
      }

      // ─── Champions (cross-game season) ───
      async function loadChampions() {
        const monthStart = startOfMonth();
        const monthEl = document.querySelector('[data-champions-month]');
        if (monthEl) monthEl.textContent = monthLabel();

        // Pull a generous slice so personal-rank lookup works for non-top players.
        const standings = await supaFetch(
          `season_standings?month=eq.${monthStart}&order=bkp_total.desc,golds.desc&limit=200`,
        );

        const tbody = document.querySelector('[data-champions-rows]');
        if (tbody) {
          if (standings.length === 0) {
            tbody.innerHTML =
              '<tr><td class="px-4 py-6 text-center text-slate-400 italic" colspan="6">No scores posted this season yet.</td></tr>';
          } else {
            tbody.innerHTML = standings
              .slice(0, 20)
              .map((r, i) => {
                const mine = isMine(r.player_handle);
                return `<tr class="${mine ? 'bg-[var(--color-ochre)]/10' : i % 2 ? 'bg-white/40' : ''} border-t border-slate-900/5">
                  <td class="px-4 py-2 font-mono text-[12px] text-slate-500">${i + 1}</td>
                  <td class="px-4 py-2 ${mine ? 'font-semibold' : ''} text-[var(--color-ink)]">${escapeHtml(r.player_handle)}${verifiedBadge(r.verified)}${mine ? ' <span class="font-mono text-[9px] tracking-[0.16em] uppercase text-[var(--color-ochre)] ml-1">you</span>' : ''}</td>
                  <td class="px-4 py-2 text-right font-mono">${r.bkp_total}</td>
                  <td class="px-4 py-2 text-right font-mono text-[12px] text-slate-500 hidden sm:table-cell">${r.days_played}</td>
                  <td class="px-4 py-2 text-right font-mono text-[12px] text-slate-500 hidden sm:table-cell">${r.games_played}</td>
                  <td class="px-4 py-2 text-right font-mono text-[12px] text-slate-500 hidden sm:table-cell">${r.golds}</td>
                </tr>`;
              })
              .join('');
          }
        }

        // Personal rank
        const rankEl = document.querySelector('[data-champions-rank]');
        if (rankEl) {
          if (!myHandle) {
            rankEl.textContent = 'Set your handle above to find your season rank.';
          } else {
            const idx = standings.findIndex(
              (r) => r.player_handle.toLowerCase() === myHandle.toLowerCase(),
            );
            if (idx === -1) {
              rankEl.textContent = `${myHandle} hasn't posted a score this season yet — or is outside the top 200.`;
            } else {
              const me = standings[idx];
              rankEl.textContent = `You are #${idx + 1} this season — ${me.bkp_total} BKP across ${me.days_played} day${me.days_played === 1 ? '' : 's'} and ${me.games_played} game${me.games_played === 1 ? '' : 's'}.`;
            }
          }
        }
      }

      // initial load
      activate('today');
    })();
  </script>
</BaseLayout>
