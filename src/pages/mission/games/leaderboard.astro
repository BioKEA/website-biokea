---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import {
  LEADERBOARD_GAMES,
  KNOWN_HANDLE_KEYS,
  SUPABASE_URL,
  SUPABASE_PUBLISHABLE_KEY,
} from '@/data/leaderboard-games';
---

<BaseLayout
  title="Daily Leaderboard — BioKEA Games"
  description="Daily-mode standings across the four arcade games — Codon Collider, Pipette Rush, Plasmid Plinko, and Particle Accelerator."
>
  <section class="max-w-5xl mx-auto px-6 pt-8">
    <a
      href="/mission/games/"
      class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 hover:text-[var(--color-teal)] transition"
    >
      ← All games
    </a>
  </section>

  <section class="max-w-5xl mx-auto px-6 pt-6 pb-12">
    <Eyebrow>STORYTELLING · LEADERBOARD</Eyebrow>
    <div class="mt-3 grid lg:grid-cols-[minmax(0,52ch)_minmax(0,1fr)] gap-x-10 gap-y-6 items-start">
      <div>
        <h1
          class="text-4xl md:text-5xl font-semibold tracking-[-0.025em] leading-[1.05] text-[var(--color-ink)]"
        >
          Leaderboard
        </h1>
        <p class="mt-5 text-slate-600 leading-relaxed">
          Daily-mode runs — <strong>one seed per day, fresh start every game</strong>. Three views:
          today's standings, the rolling 7-day best, and the all-time best. Each game has its own
          scoreboard.
        </p>
        <p class="mt-3 text-xs text-slate-500 leading-relaxed">
          Only the four daily-mode games count: Codon Collider, Pipette Rush, Plasmid Plinko,
          Particle Accelerator. Long-form games (Biodiversity Discovery Lab, WildCal) track progress
          in their own panels and don't post here.
        </p>
      </div>

      <aside
        class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md p-4"
        data-handle-finder
      >
        <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-ochre)]">
          Find me
        </div>
        <p class="mt-1 text-[12px] text-slate-600 leading-snug">
          Type the handle you use in the games to highlight your rows.
        </p>
        <div class="mt-3 flex gap-2">
          <input
            type="text"
            data-handle-input
            placeholder="handle"
            maxlength="32"
            class="flex-1 border border-slate-900/15 rounded-sm px-3 py-2 bg-white/90 text-[var(--color-ink)] text-sm font-mono"
          />
          <button
            type="button"
            data-handle-set
            class="bg-[var(--color-ink)] text-[var(--color-cream)] px-3 py-2 rounded-sm font-semibold text-xs uppercase tracking-[0.08em]"
          >
            Set
          </button>
        </div>
      </aside>
    </div>
  </section>

  <!-- Tab nav -->
  <section
    class="max-w-5xl mx-auto px-6 sticky top-0 z-30 bg-[var(--color-cream)]/95 backdrop-blur"
  >
    <div role="tablist" class="flex gap-1 border-b border-slate-900/15">
      <button
        type="button"
        role="tab"
        data-tab="today"
        class="px-4 py-3 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 border-b-2 border-transparent transition data-[active=true]:text-[var(--color-ink)] data-[active=true]:border-[var(--color-ink)]"
        data-active="true"
      >
        Today
      </button>
      <button
        type="button"
        role="tab"
        data-tab="week"
        class="px-4 py-3 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 border-b-2 border-transparent transition data-[active=true]:text-[var(--color-ink)] data-[active=true]:border-[var(--color-ink)]"
      >
        Week
      </button>
      <button
        type="button"
        role="tab"
        data-tab="all"
        class="px-4 py-3 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 border-b-2 border-transparent transition data-[active=true]:text-[var(--color-ink)] data-[active=true]:border-[var(--color-ink)]"
      >
        All-time
      </button>
    </div>
  </section>

  <!-- Today panel -->
  <section
    class="max-w-5xl mx-auto px-6 py-10 hidden data-[active=true]:block"
    data-panel="today"
    data-active="true"
  >
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">
        Today's leaders
      </h2>
      <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-slate-500" data-today-date
        >—</span
      >
    </div>
    <div class="grid md:grid-cols-2 gap-4" data-today-per-game>
      <!-- Per-game blocks injected by JS -->
    </div>
  </section>

  <!-- Week panel -->
  <section class="max-w-5xl mx-auto px-6 py-10 hidden data-[active=true]:block" data-panel="week">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">Last 7 days</h2>
      <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-slate-500" data-week-range
        >—</span
      >
    </div>
    <p class="text-sm text-slate-600 leading-relaxed mb-6">
      Best score per player per game over the rolling 7-day window. One row per player — their
      single best run, with the day it was set.
    </p>
    <div class="grid md:grid-cols-2 gap-4" data-week-per-game></div>
  </section>

  <!-- All-time panel -->
  <section class="max-w-5xl mx-auto px-6 py-10 hidden data-[active=true]:block" data-panel="all">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">
        All-time leaders
      </h2>
      <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-slate-500"
        >since launch</span
      >
    </div>
    <p class="text-sm text-slate-600 leading-relaxed mb-6">
      Best score per player per game across every daily seed since the games went live. One row per
      player — their single best run, with the day it was set.
    </p>
    <div class="grid md:grid-cols-2 gap-4" data-all-per-game></div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-12">
    <a
      href="/mission/games/"
      class="inline-flex items-center gap-2 font-mono-label text-[var(--color-ochre)] hover:text-[var(--color-teal)]"
    >
      ← Back to all games
    </a>
  </section>

  <script
    is:inline
    define:vars={{
      supabaseUrl: SUPABASE_URL,
      supabaseKey: SUPABASE_PUBLISHABLE_KEY,
      games: LEADERBOARD_GAMES,
      handleKeys: KNOWN_HANDLE_KEYS,
    }}
  >
    (() => {
      const HANDLE_STORAGE_KEY = 'biokea:leaderboard:handle';

      const escapeHtml = (s) =>
        String(s).replace(
          /[&<>"']/g,
          (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
        );

      const fmtScore = (score, unit) => {
        if (unit === 'sec') {
          const m = Math.floor(score / 60);
          const r = Math.floor(score % 60);
          return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
        }
        return Number(score).toLocaleString();
      };

      // Use UTC so the date key matches Codon Collider's daily seeds,
      // which are also UTC-based. Without this, players in UTC− time zones
      // see evening scores vanish because the game stores them under the
      // next UTC day while the page was querying the current local day.
      const todayKey = () => new Date().toISOString().slice(0, 10);

      // Inclusive start of the rolling 7-day window ending today. Lex
      // compare on YYYY-MM-DD seeds is chronological so this works as a
      // PostgREST gte filter directly.
      const weekStart = (today) => {
        const d = new Date(today + 'T00:00:00Z');
        d.setUTCDate(d.getUTCDate() - 6);
        return d.toISOString().slice(0, 10);
      };

      const fmtRangeLabel = (from, to) => `${from} → ${to}`;

      const supaFetch = (path) =>
        fetch(`${supabaseUrl}/rest/v1/${path}`, {
          headers: { apikey: supabaseKey, Authorization: `Bearer ${supabaseKey}` },
        }).then((r) => (r.ok ? r.json() : []));

      // ─── handle finder ───
      function getStoredHandle() {
        try {
          const direct = localStorage.getItem(HANDLE_STORAGE_KEY);
          if (direct) return direct;
          for (const k of handleKeys) {
            const v = localStorage.getItem(k);
            if (v && v.trim().length > 0) return v.trim();
          }
        } catch {}
        return null;
      }

      function setStoredHandle(handle) {
        try {
          localStorage.setItem(HANDLE_STORAGE_KEY, handle);
        } catch {}
      }

      let myHandle = getStoredHandle();
      const handleInput = document.querySelector('[data-handle-input]');
      const handleSet = document.querySelector('[data-handle-set]');
      if (handleInput && myHandle) handleInput.value = myHandle;
      if (handleSet) {
        handleSet.addEventListener('click', () => {
          const v = (handleInput?.value ?? '').trim();
          if (!v) return;
          myHandle = v;
          setStoredHandle(v);
          const active = document.querySelector('[data-panel][data-active="true"]');
          const tab = active?.getAttribute('data-panel');
          if (tab === 'today') void loadToday();
          else if (tab === 'week') void loadWeek();
          else if (tab === 'all') void loadAll();
        });
      }

      // ─── tab switching ───
      const tabBtns = document.querySelectorAll('[data-tab]');
      const panels = document.querySelectorAll('[data-panel]');
      const loaded = { today: false, week: false, all: false };
      function activate(tabName) {
        tabBtns.forEach((b) =>
          b.setAttribute('data-active', b.getAttribute('data-tab') === tabName ? 'true' : 'false'),
        );
        panels.forEach((p) =>
          p.setAttribute(
            'data-active',
            p.getAttribute('data-panel') === tabName ? 'true' : 'false',
          ),
        );
        if (tabName === 'today' && !loaded.today) {
          loaded.today = true;
          void loadToday();
        } else if (tabName === 'week' && !loaded.week) {
          loaded.week = true;
          void loadWeek();
        } else if (tabName === 'all' && !loaded.all) {
          loaded.all = true;
          void loadAll();
        }
      }
      tabBtns.forEach((b) =>
        b.addEventListener('click', () => activate(b.getAttribute('data-tab'))),
      );

      const isMine = (handle) =>
        myHandle && handle && handle.toLowerCase() === myHandle.toLowerCase();

      // ─── Today (per-game only) ───
      async function loadToday() {
        const day = todayKey();
        const dateEl = document.querySelector('[data-today-date]');
        if (dateEl) dateEl.textContent = day;

        const grid = document.querySelector('[data-today-per-game]');
        if (!grid) return;
        grid.innerHTML = games
          .map(
            (g) => `
              <div class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden" data-today-game="${g.id}">
                <div class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2 flex items-baseline justify-between">
                  <a href="${g.playUrl}" class="text-sm font-semibold hover:text-[var(--color-ochre)]">${escapeHtml(g.title)}</a>
                  <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[var(--color-cream)]/60">${g.unit === 'sec' ? 'time' : 'pts'}</span>
                </div>
                <ol class="divide-y divide-slate-900/5" data-rows>
                  <li class="px-4 py-3 text-[12px] font-mono text-slate-400 italic">loading…</li>
                </ol>
              </div>`,
          )
          .join('');

        await Promise.all(
          games.map(async (g) => {
            // Pull more than top 10 (8x) so the per-handle dedupe still
            // leaves a full top 10 after collapsing repeat posters. The
            // four arcade games each post a fresh row per game-end (no
            // client-side personal-best gate for pipette/plasmid/
            // particle), so a single player can occupy several rows of
            // the raw `scores` table for one daily seed.
            const params = new URLSearchParams({
              select: 'player_handle,score,created_at',
              game_id: `eq.${g.id}`,
              mode: `eq.${g.mode}`,
              seed: `eq.${day}`,
              order: 'score.desc',
              limit: '80',
            });
            const rows = await supaFetch(`scores?${params}`);
            const block = grid.querySelector(`[data-today-game="${g.id}"] [data-rows]`);
            if (!block) return;
            const top = bestByHandle(rows).slice(0, 10);
            if (top.length === 0) {
              block.innerHTML =
                '<li class="px-4 py-3 text-[11px] font-mono text-slate-400 italic">no scores yet · be the first</li>';
              return;
            }
            block.innerHTML = top
              .map((r, i) => {
                const mine = isMine(r.player_handle);
                return `<li class="px-4 py-2 flex items-baseline justify-between gap-3 ${mine ? 'bg-[var(--color-ochre)]/10' : ''}">
                  <div class="flex items-baseline gap-2 min-w-0">
                    <span class="font-mono text-[10px] text-slate-400 w-4 text-right">${i + 1}</span>
                    <span class="text-sm truncate ${mine ? 'font-semibold' : ''} text-[var(--color-ink)]">${escapeHtml(r.player_handle)}</span>
                  </div>
                  <span class="font-mono text-[12px] text-[var(--color-ink)]">${fmtScore(r.score, g.unit)}</span>
                </li>`;
              })
              .join('');
          }),
        );
      }

      // Collapse to one row per handle (their best). Used for the week
      // + all-time windows so a single dominant player doesn't fill a
      // whole top 10. Mirrors the bestByHandle helper in each game's
      // lib so the central page and in-game panels rank consistently.
      function bestByHandle(rows) {
        const best = new Map();
        for (const r of rows) {
          const existing = best.get(r.player_handle);
          if (!existing || r.score > existing.score) best.set(r.player_handle, r);
        }
        return Array.from(best.values()).sort((a, b) => b.score - a.score);
      }

      function rangeBlockHtml(idAttr, gameTitle, gameUrl, eyebrow) {
        return `
          <div class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden" ${idAttr}>
            <div class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2 flex items-baseline justify-between">
              <a href="${gameUrl}" class="text-sm font-semibold hover:text-[var(--color-ochre)]">${escapeHtml(gameTitle)}</a>
              <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[var(--color-cream)]/60">${eyebrow}</span>
            </div>
            <ol class="divide-y divide-slate-900/5" data-rows>
              <li class="px-4 py-3 text-[12px] font-mono text-slate-400 italic">loading…</li>
            </ol>
          </div>`;
      }

      function renderRangeRows(block, rows, unit, emptyText) {
        if (rows.length === 0) {
          block.innerHTML = `<li class="px-4 py-3 text-[11px] font-mono text-slate-400 italic">${emptyText}</li>`;
          return;
        }
        block.innerHTML = rows
          .map((r, i) => {
            const mine = isMine(r.player_handle);
            const seedSuffix = (r.seed || '').slice(5);
            return `<li class="px-4 py-2 flex items-baseline justify-between gap-3 ${mine ? 'bg-[var(--color-ochre)]/10' : ''}">
              <div class="flex items-baseline gap-2 min-w-0">
                <span class="font-mono text-[10px] text-slate-400 w-4 text-right">${i + 1}</span>
                <span class="text-sm truncate ${mine ? 'font-semibold' : ''} text-[var(--color-ink)]">${escapeHtml(r.player_handle)}</span>
              </div>
              <div class="flex items-baseline gap-2 shrink-0">
                <span class="font-mono text-[12px] text-[var(--color-ink)]">${fmtScore(r.score, unit)}</span>
                <span class="font-mono text-[10px] text-slate-500">${seedSuffix}</span>
              </div>
            </li>`;
          })
          .join('');
      }

      // ─── Week (rolling 7-day, best-per-player per game) ───
      async function loadWeek() {
        const today = todayKey();
        const from = weekStart(today);
        const rangeEl = document.querySelector('[data-week-range]');
        if (rangeEl) rangeEl.textContent = fmtRangeLabel(from, today);

        const grid = document.querySelector('[data-week-per-game]');
        if (!grid) return;
        grid.innerHTML = games
          .map((g) => rangeBlockHtml(`data-week-game="${g.id}"`, g.title, g.playUrl, '7-day top'))
          .join('');

        await Promise.all(
          games.map(async (g) => {
            // Pull a generous slice (8x) so the per-handle dedupe still
            // leaves a full top 10 after collapsing repeat posters.
            const params = new URLSearchParams({
              select: 'player_handle,score,seed,created_at',
              game_id: `eq.${g.id}`,
              mode: `eq.${g.mode}`,
              seed: `gte.${from}`,
              order: 'score.desc',
              limit: '80',
            });
            // PostgREST treats repeat keys as additive, so we need the
            // upper bound on a separately appended `and` clause.
            const url = `scores?${params}&seed=lte.${today}`;
            const rows = await supaFetch(url);
            const block = grid.querySelector(`[data-week-game="${g.id}"] [data-rows]`);
            if (!block) return;
            const top = bestByHandle(rows).slice(0, 10);
            renderRangeRows(block, top, g.unit, 'no scores yet this week');
          }),
        );
      }

      // ─── All-time (best-per-player per game) ───
      async function loadAll() {
        const grid = document.querySelector('[data-all-per-game]');
        if (!grid) return;
        grid.innerHTML = games
          .map((g) => rangeBlockHtml(`data-all-game="${g.id}"`, g.title, g.playUrl, 'all-time top'))
          .join('');

        await Promise.all(
          games.map(async (g) => {
            const params = new URLSearchParams({
              select: 'player_handle,score,seed,created_at',
              game_id: `eq.${g.id}`,
              mode: `eq.${g.mode}`,
              order: 'score.desc',
              limit: '80',
            });
            const rows = await supaFetch(`scores?${params}`);
            const block = grid.querySelector(`[data-all-game="${g.id}"] [data-rows]`);
            if (!block) return;
            const top = bestByHandle(rows).slice(0, 10);
            renderRangeRows(block, top, g.unit, 'no scores yet · be the first');
          }),
        );
      }

      // initial load — honour ?tab= or #tab so cross-links from other
      // pages can land directly on a specific panel.
      const validTabs = ['today', 'week', 'all'];
      const initialTab = (() => {
        const fromHash = (location.hash || '').replace('#', '');
        if (validTabs.includes(fromHash)) return fromHash;
        const fromQuery = new URLSearchParams(location.search).get('tab');
        if (fromQuery && validTabs.includes(fromQuery)) return fromQuery;
        return 'today';
      })();
      activate(initialTab);
    })();
  </script>
</BaseLayout>
