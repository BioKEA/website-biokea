---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import SubscribeForm from '@/components/forms/SubscribeForm.astro';
import { games } from '@/data/games';
import { stringifyJsonLd } from '@/lib/json-ld';
import {
  CAMPAIGN_OPENS_ISO,
  CAMPAIGN_CLOSES_ISO,
  HUNT_NAME,
  PRIZE_CAP,
  SLOTS,
} from '@/lib/golden-sample/config';

// Display dates derived from canonical ISO constants in config.ts so
// the copy stays in sync with what the API enforces.
const launchDate = CAMPAIGN_OPENS_ISO.slice(0, 10);
const deadlineDate = CAMPAIGN_CLOSES_ISO.slice(0, 10);

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'BioKEA Golden Sample Hunt',
  startDate: launchDate,
  endDate: deadlineDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  description:
    'A 60-day public hunt across six BioKEA games. Earn six golden samples by playing — collect them all and ten winners receive real molecular sequencing of their own backyard soil.',
  organizer: { '@id': 'https://biokea.ai/#org' },
  location: {
    '@type': 'VirtualLocation',
    url: 'https://biokea.ai/mission/games/golden-sample-26',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://biokea.ai/mission/games/golden-sample-26',
  },
};

// Build the slot→game lookup so the collection wall can render its
// game-link + hint per slot at server render time. (The held/word
// state is filled in client-side from /api/golden-sample/state.)
const gamesBySlug = new Map(games.map((g) => [g.slug, g]));
// `hint` is intentionally omitted — the page no longer surfaces how
// to earn each slot. Players discover the unlock conditions by
// playing the games themselves.
const slotsRender = SLOTS.map((s) => {
  const g = gamesBySlug.get(s.game);
  return {
    slot: s.slot,
    title: g?.title ?? s.game,
    playUrl: g?.playUrl ?? `/mission/games/${s.game}/`,
    thumb: g?.thumb ?? '/assets/images/golden-sample-card.png',
  };
});
---

<BaseLayout
  title="The Golden Sample Hunt — BioKEA"
  description={`A 60-day public hunt across six BioKEA games. Earn six golden samples by playing; ${PRIZE_CAP} winners receive real sequencing of their own backyard soil. Launches ${launchDate}; deadline ${deadlineDate}.`}
  ogImage="/assets/images/golden-sample-card.png"
  preloadImage="/assets/images/golden-sample-card.png"
  preloadImageType="image/png"
>
  <!-- Top nav back-bar — matches the pattern on /mission/games/leaderboard
       so the three game-area pages (games index, leaderboard, hunt) all
       share the same back-out shape. -->
  <section class="max-w-6xl mx-auto px-6 pt-8">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <a
        href="/mission/games/"
        class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500 hover:text-[var(--color-teal)] transition"
      >
        ← All games
      </a>
      <a
        href="/mission/games/leaderboard#hunt"
        class="font-mono text-[11px] tracking-[0.16em] uppercase text-[var(--color-ochre)] hover:text-[var(--color-teal)] transition"
      >
        Hunt leaderboard →
      </a>
    </div>
  </section>

  <!-- ZONE A — promo hero (full-bleed navy + gold) -->
  <section class="bg-[var(--color-ink)] text-[var(--color-cream)] mt-6">
    <div
      class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-[1.1fr_1fr] gap-10 items-center"
    >
      <div>
        <p
          class="font-mono text-[11px] tracking-[0.2em] uppercase font-semibold text-[var(--color-gold)]"
        >
          ONE LAST THING · A HUNT
        </p>
        <h1
          class="mt-4 text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.025em] leading-[1.05]"
        >
          There is a hidden world<br />all around you.
        </h1>
        <p class="mt-4 italic text-2xl md:text-3xl text-[var(--color-gold)]">
          Even under your feet.
        </p>
        <p class="mt-8 max-w-[52ch] text-slate-300 leading-relaxed">
          Hidden across six BioKEA games are six golden samples. One in each game. Reach a milestone
          in each, and the games reveal a word — six words that spell out a single sentence about
          what biology is becoming.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#collection"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-sm border border-[var(--color-gold)] text-[var(--color-gold)] hover:bg-[var(--color-gold)] hover:text-[var(--color-ink)] transition"
          >
            Open my collection ↓
          </a>
          <a
            href="#how"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-sm bg-[var(--color-gold)] text-[var(--color-ink)] font-semibold hover:bg-[var(--color-gold-soft)] transition"
          >
            How it works ↓
          </a>
        </div>
        <p
          class="mt-6 text-[11px] font-mono uppercase tracking-[0.18em] text-[var(--color-gold)]/70"
        >
          Best on desktop · keyboard + mouse for now
        </p>
      </div>
      <figure class="md:justify-self-end">
        <img
          src="/assets/images/golden-sample-card.png"
          alt="The Golden Sample Card — gold and navy ornamental keepsake card depicting a swirling galaxy of soil, water, and specimen icons."
          width="1438"
          height="830"
          class="w-full max-w-[520px] rounded-md shadow-[0_20px_60px_rgba(0,0,0,0.5)]"
        />
      </figure>
    </div>
  </section>

  <!-- ZONE B — How it works -->
  <section id="how" class="max-w-3xl mx-auto px-6 py-16">
    <Eyebrow>HOW IT WORKS</Eyebrow>
    <ol class="mt-6 space-y-6">
      <li class="grid grid-cols-[40px_1fr] gap-4">
        <span class="font-mono text-[var(--color-ochre)] font-semibold">01</span>
        <div>
          <h2 class="text-lg font-semibold text-[var(--color-ink)]">Pick a handle</h2>
          <p class="mt-1 text-slate-600 leading-relaxed">
            Use the same handle in every BioKEA game — that's how your collection follows you across
            games and devices. (Play on a desktop browser; mobile support is coming.)
          </p>
        </div>
      </li>
      <li class="grid grid-cols-[40px_1fr] gap-4">
        <span class="font-mono text-[var(--color-ochre)] font-semibold">02</span>
        <div>
          <h2 class="text-lg font-semibold text-[var(--color-ink)]">Earn a sample</h2>
          <p class="mt-1 text-slate-600 leading-relaxed">
            Each game has a hidden milestone. Reach it and a golden sample appears with one word
            from the answer. Six games. Six words.
          </p>
        </div>
      </li>
      <li class="grid grid-cols-[40px_1fr] gap-4">
        <span class="font-mono text-[var(--color-ochre)] font-semibold">03</span>
        <div>
          <h2 class="text-lg font-semibold text-[var(--color-ink)]">Watch your collection fill</h2>
          <p class="mt-1 text-slate-600 leading-relaxed">
            Come back here. Your slots light up automatically once you've played any of the games.
          </p>
        </div>
      </li>
      <li class="grid grid-cols-[40px_1fr] gap-4">
        <span class="font-mono text-[var(--color-ochre)] font-semibold">04</span>
        <div>
          <h2 class="text-lg font-semibold text-[var(--color-ink)]">Claim your prize</h2>
          <p class="mt-1 text-slate-600 leading-relaxed">
            All six? The full sentence reveals — and the form below opens. Submit your address. The
            first <strong>{PRIZE_CAP}</strong> handles to complete the hunt receive real sequencing of
            their own backyard soil.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- ZONE C — Collection wall -->
  <section id="collection" class="max-w-5xl mx-auto px-6 py-12">
    <Eyebrow>YOUR COLLECTION</Eyebrow>
    <div class="mt-3 grid lg:grid-cols-[minmax(0,40ch)_minmax(0,1fr)] gap-x-10 gap-y-6 items-start">
      <div>
        <h2
          class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] leading-tight text-[var(--color-ink)]"
        >
          Six slots. One sentence.
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Your slots fill in automatically based on what you've earned. The handle is whatever you
          chose the first time a game prompted you.
        </p>

        <div
          class="mt-6 rounded-sm bg-[var(--color-cream-warm)] border border-slate-900/10 px-4 py-3"
          data-collection-meta
        >
          <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-ochre)]">
            Playing as
          </div>
          <div
            class="mt-0.5 font-mono text-sm font-semibold text-[var(--color-ink)] truncate"
            data-collection-handle-label
          >
            <span class="text-slate-400 italic font-normal">checking…</span>
          </div>
          <div
            class="mt-2 font-mono text-[11px] tracking-[0.16em] uppercase text-slate-500"
            data-collection-status
          >
            —
          </div>
          <div
            class="mt-1 font-mono text-[11px] tracking-[0.16em] uppercase text-[var(--color-ochre)]"
            data-collection-prizes
          >
            —
          </div>
        </div>

        <div
          class="mt-4 hidden data-[show=true]:block rounded-sm border border-dashed border-slate-300 bg-slate-50 px-4 py-3 text-[12px] text-slate-600 leading-snug"
          data-collection-empty
        >
          Play any of the six games below to earn your first golden sample. Your collection will
          start showing up here automatically once you've picked a handle in-game.
        </div>
      </div>

      <ol class="grid sm:grid-cols-2 gap-4" data-collection-slots>
        {
          slotsRender.map((s) => (
            <li
              class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden flex flex-col"
              data-slot={s.slot}
            >
              <div class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2 flex items-baseline justify-between">
                <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-[var(--color-gold)]">
                  Slot {s.slot}
                </span>
                <span
                  class="font-mono text-[9px] tracking-[0.18em] uppercase text-[var(--color-cream)]/55"
                  data-slot-state
                >
                  sealed
                </span>
              </div>
              <div class="p-4 flex-1 flex flex-col">
                <h3 class="text-sm font-semibold text-[var(--color-ink)]">{s.title}</h3>
                {/*
                  How to earn each slot is intentionally NOT listed —
                  discovery is part of the hunt. Players figure it out
                  by playing.
                */}
                <p class="mt-1 text-[12px] text-slate-500 italic leading-snug">
                  Play to earn this slot.
                </p>
                <div
                  class="mt-3 flex items-center justify-center min-h-[44px] rounded-sm border border-dashed border-slate-300 bg-white/60"
                  data-slot-word
                >
                  <span class="font-mono text-[11px] tracking-[0.18em] uppercase text-slate-400">
                    ·····
                  </span>
                </div>
                <a
                  href={s.playUrl}
                  class="mt-3 font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-pink)] hover:text-[var(--color-teal)]"
                >
                  Play {s.title} →
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div
      class="mt-10 hidden data-[show=true]:block bg-[var(--color-ink)] text-[var(--color-cream)] rounded-md p-6 md:p-8 text-center"
      data-sentence-reveal
    >
      <p class="font-mono text-[10px] tracking-[0.28em] uppercase text-[var(--color-gold)]">
        Six of six · the message
      </p>
      <p
        class="mt-3 text-3xl md:text-4xl font-semibold tracking-[-0.02em] leading-tight"
        data-sentence-text
      >
        —
      </p>
      <p class="mt-3 text-[12px] text-[var(--color-cream)]/65 max-w-[52ch] mx-auto">
        Claim your prize below — first {PRIZE_CAP} handles to complete the hunt win real sequencing of
        their own backyard soil.
      </p>
    </div>
  </section>

  <!-- ZONE D — The games -->
  <section id="the-games" class="max-w-6xl mx-auto px-6 py-12">
    <Eyebrow>THE GAMES</Eyebrow>
    <p class="mt-3 max-w-[62ch] text-slate-600 leading-relaxed">
      Six playable games. One golden sample hidden inside each. Click in, play, and reach the
      milestone — the reveal will find you.
    </p>
    <ul class="mt-6 grid md:grid-cols-3 gap-4">
      {
        games.map((g) => (
          <li class="border border-slate-900/10 rounded-md overflow-hidden bg-[var(--color-cream-warm)] flex flex-col">
            <a href={g.playUrl} class="block group">
              <img
                src={g.thumb}
                alt={`${g.title} screenshot`}
                width="1200"
                height="750"
                class="w-full aspect-[8/5] object-cover bg-slate-900 group-hover:opacity-90 transition"
                loading="lazy"
              />
            </a>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="font-semibold text-[var(--color-ink)]">{g.title}</h3>
              <p class="mt-1 text-sm text-slate-600 leading-relaxed flex-1">{g.tagline}</p>
              <p class="mt-3 text-xs font-mono text-[var(--color-ochre)]">
                🔒 Golden sample hidden inside
              </p>
              <a
                href={g.playUrl}
                class="mt-3 inline-block text-sm font-semibold underline decoration-slate-400 hover:text-[var(--color-teal)]"
              >
                Play →
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ZONE E — The prize -->
  <section class="max-w-3xl mx-auto px-6 py-12">
    <Eyebrow>THE PRIZE</Eyebrow>
    <p class="mt-3 text-slate-600 leading-relaxed">
      The first <strong>{PRIZE_CAP}</strong> handles to collect all six golden samples receive:
    </p>
    <ul class="mt-4 space-y-2 text-slate-700">
      <li>· Real molecular sequencing of soil sampled from your own backyard.</li>
      <li>· A full report (PDF) of what was found.</li>
      <li>· The raw sequencing data (FASTQ).</li>
      <li>· A Claude-powered explorer for asking your data questions in plain English.</li>
    </ul>
  </section>

  <!-- ZONE F — Rules -->
  <section class="max-w-3xl mx-auto px-6 py-12">
    <Eyebrow>RULES</Eyebrow>
    <ul class="mt-4 space-y-2 text-sm text-slate-600 leading-relaxed">
      <li>
        · Hunt window: <strong>{launchDate}</strong> through <strong>{deadlineDate}</strong> (~60 days).
        Tickets earned outside this window won't count toward the prize.
      </li>
      <li>· US residents only.</li>
      <li>· Must be 18+ at the time of redemption.</li>
      <li>· One redemption per handle.</li>
      <li>· Best played on a desktop browser. Mobile support is coming.</li>
      <li>
        · Automated submissions, source-scraping, or LLM-assisted spoiler retrieval will be
        disqualified — that's not the spirit of this. Earn it.
      </li>
      <li>
        · Winners are notified by email; allow 4–6 weeks for kit delivery, sample return,
        sequencing, and report.
      </li>
      <li>· Email and address are used only for prize fulfillment.</li>
    </ul>
  </section>

  <!-- ZONE G — Redeem -->
  <section id="submit" class="max-w-3xl mx-auto px-6 py-12">
    <Eyebrow>CLAIM YOUR PRIZE</Eyebrow>
    <p class="mt-3 text-sm text-slate-600 leading-relaxed">
      Available once your collection is complete (six of six). Submit the handle you played under
      and the address where the kit should ship.
    </p>

    <form data-redeem-form class="mt-6 grid gap-3 hidden data-[show=true]:grid" novalidate>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="grid gap-1">
          <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
            Handle
          </span>
          <input
            required
            name="handle"
            data-redeem-handle
            class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
          />
        </label>
        <label class="grid gap-1">
          <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
            Email
          </span>
          <input
            required
            type="email"
            name="email"
            class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
          />
        </label>
      </div>
      <label class="grid gap-1">
        <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
          Full name
        </span>
        <input
          required
          name="name"
          class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
        />
      </label>
      <label class="grid gap-1">
        <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
          Street address
        </span>
        <input
          required
          name="line1"
          class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
        />
      </label>
      <label class="grid gap-1">
        <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
          Apt / unit (optional)
        </span>
        <input
          name="line2"
          class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
        />
      </label>
      <div class="grid sm:grid-cols-3 gap-3">
        <label class="grid gap-1">
          <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
            City
          </span>
          <input
            required
            name="city"
            class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
          />
        </label>
        <label class="grid gap-1">
          <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
            State / region
          </span>
          <input
            name="region"
            class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
          />
        </label>
        <label class="grid gap-1">
          <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
            Postal code
          </span>
          <input
            required
            name="postal"
            class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
          />
        </label>
      </div>
      <label class="grid gap-1">
        <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-[var(--color-teal)]">
          Country
        </span>
        <input
          required
          name="country"
          value="United States"
          class="border border-slate-900/15 rounded-sm px-3 py-2.5 bg-white/80 text-[var(--color-ink)]"
        />
      </label>
      <button
        type="submit"
        class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-3 rounded-sm font-semibold text-sm self-start"
      >
        Claim my prize →
      </button>
      <p
        data-redeem-status
        role="status"
        aria-live="polite"
        class="text-sm text-slate-600 min-h-[1.25rem]"
      >
      </p>
    </form>

    <p
      data-redeem-locked
      class="mt-6 rounded-md border border-dashed border-slate-300 bg-slate-50 p-6 text-sm text-slate-600"
    >
      Load your collection above. The form unlocks when you've earned all six.
    </p>
  </section>

  <!-- ZONE H — Lab updates -->
  <section class="max-w-3xl mx-auto px-6 py-12">
    <div class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md p-6">
      <Eyebrow>LAB UPDATES</Eyebrow>
      <h2
        class="mt-2 text-2xl font-semibold tracking-[-0.015em] text-[var(--color-ink)] leading-tight"
      >
        Not in the US? Hunt over? Stay in the loop.
      </h2>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        The hunt is US-only this round, but lab updates from BioKEA are open to anyone — new games,
        papers, the next challenge.
      </p>
      <div class="mt-4">
        <SubscribeForm source="golden-sample-26" />
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 text-center">
    <hr class="border-t border-[var(--color-gold)] w-16 mx-auto" />
    <p class="mt-6 italic text-slate-700 text-lg">Biodiversity can be discovered anywhere.</p>
  </section>

  <script type="application/ld+json" is:inline set:html={stringifyJsonLd(eventLd)} />

  <script
    is:inline
    define:vars={{
      huntName: HUNT_NAME,
      slotCount: SLOTS.length,
    }}
  >
    (() => {
      const HANDLE_KEY = 'biokea:player:handle';
      const TICKETS_KEY = 'biokea:golden-tickets:v1';
      // Per-device anonymous UUID, set by @biokea/leaderboard on first
      // submit from any BioKEA game. Passed to /api/golden-sample/state
      // so the server only discloses words for slots earned on this
      // device. The page auto-loads the player's own collection — no
      // handle-lookup UI, so visitors can't browse other players'
      // earned words.
      const CLIENT_ID_KEY = 'biokea-leaderboard-client-id';

      const handleLabelEl = document.querySelector('[data-collection-handle-label]');
      const statusEl = document.querySelector('[data-collection-status]');
      const prizesEl = document.querySelector('[data-collection-prizes]');
      const emptyEl = document.querySelector('[data-collection-empty]');
      const sentenceBox = document.querySelector('[data-sentence-reveal]');
      const sentenceText = document.querySelector('[data-sentence-text]');
      const redeemForm = document.querySelector('[data-redeem-form]');
      const redeemLocked = document.querySelector('[data-redeem-locked]');
      const redeemHandle = document.querySelector('[data-redeem-handle]');
      const redeemStatus = document.querySelector('[data-redeem-status]');

      function readHandle() {
        try {
          const v = localStorage.getItem(HANDLE_KEY);
          return v && v.trim().length > 0 ? v.trim() : null;
        } catch {
          return null;
        }
      }
      function readClientId() {
        try {
          return localStorage.getItem(CLIENT_ID_KEY) ?? '';
        } catch {
          return '';
        }
      }

      function setSlotState(slotEl, { held, word }) {
        const stateEl = slotEl.querySelector('[data-slot-state]');
        const wordEl = slotEl.querySelector('[data-slot-word]');
        if (held) {
          slotEl.classList.add('ring-2', 'ring-[var(--color-gold)]');
          if (stateEl) {
            stateEl.textContent = 'earned';
            stateEl.style.color = 'var(--color-gold)';
          }
          if (wordEl) {
            wordEl.classList.remove('border-dashed', 'border-slate-300');
            wordEl.classList.add(
              'border-solid',
              'border-[var(--color-gold)]',
              'bg-[var(--color-gold)]/10',
            );
            if (word) {
              wordEl.innerHTML =
                '<span class="font-bold text-base tracking-[0.04em] text-[var(--color-ink)]">' +
                String(word).toUpperCase() +
                '</span>';
            } else {
              // Edge case: held according to the server but the word
              // isn't in this device's localStorage (player cleared
              // storage, or earned on another device). Render a ✓ so
              // the slot still reads "earned"; replaying the relevant
              // game on this device repopulates the word.
              wordEl.innerHTML =
                '<span class="font-mono text-base font-bold text-[var(--color-gold)]">✓</span>';
            }
          }
        } else {
          slotEl.classList.remove('ring-2', 'ring-[var(--color-gold)]');
          if (stateEl) {
            stateEl.textContent = 'sealed';
            stateEl.style.color = '';
          }
          if (wordEl) {
            wordEl.classList.add('border-dashed', 'border-slate-300');
            wordEl.classList.remove(
              'border-solid',
              'border-[var(--color-gold)]',
              'bg-[var(--color-gold)]/10',
            );
            wordEl.innerHTML =
              '<span class="font-mono text-[11px] tracking-[0.18em] uppercase text-slate-400">·····</span>';
          }
        }
      }

      function showSentence(words) {
        if (!sentenceBox || !sentenceText) return;
        sentenceText.textContent = words.join(' ');
        sentenceBox.setAttribute('data-show', 'true');
      }

      function hideSentence() {
        if (sentenceBox) sentenceBox.removeAttribute('data-show');
      }

      function unlockRedeem(handle) {
        if (redeemForm) redeemForm.setAttribute('data-show', 'true');
        if (redeemLocked) redeemLocked.style.display = 'none';
        if (redeemHandle) redeemHandle.value = handle;
      }

      function lockRedeem() {
        if (redeemForm) redeemForm.removeAttribute('data-show');
        if (redeemLocked) redeemLocked.style.display = '';
      }

      function showEmptyState() {
        if (handleLabelEl) {
          handleLabelEl.innerHTML =
            '<span class="text-slate-400 italic font-normal">no handle yet</span>';
        }
        if (statusEl) statusEl.textContent = '0 of ' + slotCount + ' earned';
        if (prizesEl) prizesEl.textContent = '';
        if (emptyEl) emptyEl.setAttribute('data-show', 'true');
        // All slots stay sealed by default markup.
      }

      function readLocalTickets() {
        try {
          return JSON.parse(localStorage.getItem(TICKETS_KEY) ?? '{}') || {};
        } catch {
          return {};
        }
      }

      async function loadCollection() {
        const handle = readHandle();
        if (!handle) {
          showEmptyState();
          hideSentence();
          lockRedeem();
          return;
        }
        if (handleLabelEl) handleLabelEl.textContent = handle;
        if (emptyEl) emptyEl.removeAttribute('data-show');
        if (statusEl) statusEl.textContent = 'loading…';

        // Server is the source of truth for *which* slots are held +
        // global prize counts. Words are read from localStorage — the
        // in-game overlay saves them there on every earn — so the
        // wall doesn't depend on a server round-trip exposing them
        // (the API still gates per client_id as defence-in-depth).
        const clientId = readClientId();
        const params = new URLSearchParams({ handle });
        if (clientId) params.set('client_id', clientId);
        let data;
        try {
          const res = await fetch('/api/golden-sample/state?' + params.toString());
          data = await res.json();
        } catch {
          if (statusEl) statusEl.textContent = 'network error';
          return;
        }
        if (!data || !data.ok) {
          if (statusEl) statusEl.textContent = (data && data.error) || 'could not load';
          return;
        }

        const localTickets = readLocalTickets();
        const wordsBySlot = {};
        for (const s of data.slots) {
          const local = localTickets[String(s.slot)];
          // Prefer the word from this device's localStorage (saved by
          // the overlay on the run that earned it). Server response is
          // a fallback for the same-device case where client_id check
          // passes — covers the rare case of localStorage clear after
          // earn but before visit.
          const word = (local && typeof local.word === 'string' && local.word) || s.word || null;
          const slotEl = document.querySelector('[data-slot="' + s.slot + '"]');
          if (slotEl) setSlotState(slotEl, { held: s.held, word });
          if (s.held && word) wordsBySlot[s.slot] = word;
        }

        if (statusEl) {
          statusEl.textContent = data.earned_count + ' of ' + slotCount + ' earned';
        }
        if (prizesEl)
          prizesEl.textContent =
            data.prizes_remaining + ' of ' + data.prize_cap + ' prizes remaining';

        // Sentence reveal + redeem unlock require all six earned AND
        // the per-slot HMAC tokens to be present in this device's
        // localStorage (redeem submits those tokens for verification).
        const haveAllWords = Object.keys(wordsBySlot).length === slotCount;
        if (data.complete && haveAllWords) {
          const ordered = [];
          for (let i = 1; i <= slotCount; i++) ordered.push(wordsBySlot[i] || '?');
          showSentence(ordered);
          unlockRedeem(handle);
        } else {
          hideSentence();
          lockRedeem();
        }
      }

      // Auto-load on paint. No input field — handle comes from the
      // cross-game localStorage key the games already populate.
      void loadCollection();

      // Redeem form — gather tokens from localStorage (which the
      // overlay populates on each in-game earn) and POST to redeem.
      redeemForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!redeemStatus) return;
        redeemStatus.textContent = 'submitting…';
        redeemStatus.style.color = '';

        let tickets = {};
        try {
          tickets = JSON.parse(localStorage.getItem(TICKETS_KEY) ?? '{}');
        } catch {}
        const tokens = [];
        for (let i = 1; i <= slotCount; i++) {
          const t = tickets[String(i)];
          if (t && t.token) tokens.push(t.token);
        }
        if (tokens.length !== slotCount) {
          redeemStatus.textContent =
            'Missing tokens locally. Re-play any game on this device to refresh, or contact contact@biokea.ai.';
          redeemStatus.style.color = 'var(--color-pink)';
          return;
        }

        const fd = new FormData(redeemForm);
        const payload = {
          handle: String(fd.get('handle') ?? '').trim(),
          email: String(fd.get('email') ?? '').trim(),
          tokens,
          address: {
            name: String(fd.get('name') ?? '').trim(),
            line1: String(fd.get('line1') ?? '').trim(),
            line2: String(fd.get('line2') ?? '').trim(),
            city: String(fd.get('city') ?? '').trim(),
            region: String(fd.get('region') ?? '').trim(),
            postal: String(fd.get('postal') ?? '').trim(),
            country: String(fd.get('country') ?? '').trim(),
          },
        };
        try {
          const res = await fetch('/api/golden-sample/redeem', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await res.json();
          if (res.ok && body.ok) {
            redeemStatus.textContent = 'Claimed. Watch your inbox — we ship within 4–6 weeks.';
            redeemStatus.style.color = 'var(--color-teal)';
            redeemForm.reset();
            redeemForm.removeAttribute('data-show');
          } else {
            redeemStatus.textContent = body.error ?? 'Could not claim. Please try again.';
            redeemStatus.style.color = 'var(--color-pink)';
          }
        } catch {
          redeemStatus.textContent = 'Network error. Please try again.';
          redeemStatus.style.color = 'var(--color-pink)';
        }
      });
    })();
  </script>
</BaseLayout>
