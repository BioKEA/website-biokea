---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import PhotoCard from '@/components/ui/PhotoCard.astro';
import StatPill from '@/components/ui/StatPill.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { labStats, capabilityLines } from '@/data/stats';
import { equipmentByStage } from '@/data/equipment';
import { stringifyJsonLd } from '@/lib/json-ld';
---

<BaseLayout
  title="The Lab & LDC"
  description="The Berkeley lab, the Large Data Collider hardware, and collaboration with partner institutions."
  ogImage="/assets/images/og-lab.jpg"
  preloadImage="/assets/images/lab-warehouse-before.jpg"
  preloadImageType="image/jpeg"
>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-8">
    <Eyebrow>BIOKEA LAB · BERKELEY, CA</Eyebrow>
    <h1
      class="mt-3 text-4xl md:text-5xl font-semibold tracking-[-0.025em] leading-[1.05] text-[var(--color-ink)] max-w-[22ch]"
    >
      5,000+ sq ft of lab, coming online in <time datetime="2026">2026</time>.
    </h1>
    <p class="mt-5 max-w-[60ch] text-slate-600 leading-relaxed">
      The BioKEA Large Data Collider (LDC) is a combined wet-lab + compute platform in Berkeley,
      California — and the backbone of our molecular sequencing service for environmental DNA (eDNA)
      and related customers. Space secured in late 2025; move-in <time datetime="2026-03"
        >March 2026</time
      >; operating alongside partner institutions.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-5">
    <PhotoCard
      src="/assets/images/lab-warehouse-before.jpg"
      alt="Warehouse interior before buildout"
      width={973}
      height={527}
      caption="BEFORE BUILDOUT"
      class="aspect-[4/3]"
    />

    <figure
      class="relative rounded-sm overflow-hidden border border-black/10 aspect-[4/3] bg-black/5"
      data-lab-slider
      role="region"
      aria-label="Lab interior — rotating photos of the operational LDC space"
      aria-roledescription="carousel"
    >
      <img
        src="/assets/images/Lab-Photo2.jpeg"
        alt="Lab interior, operational"
        width="2856"
        height="2142"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-100"
        data-slide="0"
        data-caption="Wet-lab floor — current state"
      />
      <img
        src="/assets/images/Lab-Photo1.jpeg"
        alt="LDC interior viewed from the ground floor"
        width="2856"
        height="2142"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-0"
        data-slide="1"
        data-caption="Ground floor view"
        loading="lazy"
      />
      <img
        src="/assets/images/Lab-Photo4.jpeg"
        alt="LDC interior viewed from above, side angle"
        width="2856"
        height="2142"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-0"
        data-slide="2"
        data-caption="From above, side angle"
        loading="lazy"
      />
      <img
        src="/assets/images/Lab-Photo3.jpeg"
        alt="The BioKEA lounge and maker-space corner, in progress"
        width="2856"
        height="2142"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-0"
        data-slide="3"
        data-caption="Lounge + maker space — coming together"
        loading="lazy"
      />

      <span
        class="absolute top-2 right-2 bg-[var(--color-pink)] text-[var(--color-pink-soft)] px-2 py-1 rounded-sm font-mono text-[9px] font-semibold tracking-[0.16em] uppercase z-10"
      >
        OPERATIONAL
      </span>

      <figcaption
        class="absolute bottom-2 left-2 right-16 bg-black/45 text-[var(--color-cream)] px-2 py-1 rounded-sm font-mono text-[10px] tracking-[0.12em] uppercase z-10 transition-opacity duration-300"
        data-slider-caption
      >
        Wet-lab floor — current state
      </figcaption>

      <div
        class="absolute bottom-2 right-2 flex gap-1.5 z-10"
        role="tablist"
        aria-label="Choose lab photo"
      >
        <button
          type="button"
          data-slider-dot="0"
          aria-label="Show photo 1 of 4"
          aria-selected="true"
          class="w-2 h-2 rounded-full bg-[var(--color-cream)] transition-opacity"></button>
        <button
          type="button"
          data-slider-dot="1"
          aria-label="Show photo 2 of 4"
          aria-selected="false"
          class="w-2 h-2 rounded-full bg-[var(--color-cream)] opacity-50 transition-opacity"
        ></button>
        <button
          type="button"
          data-slider-dot="2"
          aria-label="Show photo 3 of 4"
          aria-selected="false"
          class="w-2 h-2 rounded-full bg-[var(--color-cream)] opacity-50 transition-opacity"
        ></button>
        <button
          type="button"
          data-slider-dot="3"
          aria-label="Show photo 4 of 4"
          aria-selected="false"
          class="w-2 h-2 rounded-full bg-[var(--color-cream)] opacity-50 transition-opacity"
        ></button>
      </div>
    </figure>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-14">
    <Eyebrow>WHERE WE ARE · BAY AREA</Eyebrow>
    <figure class="mt-5">
      <img
        src="/assets/images/bay-area-map1.png"
        alt="A hand-drawn editorial map of the San Francisco Bay Area showing BioKEA's Berkeley lab and partner institutions at CIB, SFEI, and Coastal Quest."
        width="1448"
        height="1086"
        class="w-full rounded-md block"
        loading="lazy"
      />
      <figcaption class="mt-3 font-mono text-[10px] tracking-[0.14em] uppercase text-slate-500">
        Fig · Berkeley lab + partner institutions + the Bay Area biotech auction circuit
      </figcaption>
    </figure>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-10">
    <p class="max-w-[62ch] text-sm text-slate-600 leading-relaxed">
      The LDC also runs as a <strong>molecular sequencing service</strong> for environmental-DNA and biodiversity-omics
      customers — DNA barcoding, eDNA, qPCR, and long-read genomics, project-rate engagements per scope.
      <a
        href="/services"
        class="text-[var(--color-teal)] underline decoration-slate-400 hover:decoration-[var(--color-teal)]"
        >See the services catalog →</a
      >
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <Eyebrow>OPERATIONAL</Eyebrow>
    <h2 class="mt-3 text-2xl font-semibold">Current state</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-6">
      {
        labStats.map((s) => (
          <StatPill value={s.value} label={s.label} live={s.live} datetime={s.datetime} />
        ))
      }
    </div>
    <div class="mt-8">
      <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-slate-500 mb-3">
        Capability
      </div>
      <ul class="space-y-1.5 text-sm text-slate-600 leading-relaxed max-w-[62ch]">
        {capabilityLines.map((line) => <li>· {line}</li>)}
      </ul>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-16">
    <Eyebrow>HARDWARE</Eyebrow>
    <h2 class="mt-3 text-2xl font-semibold max-w-[30ch]">
      A full extraction-to-sequencing pipeline, stage by stage.
    </h2>
    <p class="mt-3 text-slate-600 max-w-[62ch] leading-relaxed">
      Built across 2025–2026 through scrappy hustle at Bay Area biotech auctions — San Jose, San
      Francisco, Berkeley — picking up near-new hardware at roughly one-tenth retail cost.
      Positioned to run serious throughput on public-interest projects.
    </p>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      {
        equipmentByStage.map((stage) => (
          <article class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden flex flex-col">
            <div class="bg-white aspect-[4/3] overflow-hidden flex items-center justify-center border-b border-slate-900/10">
              <img
                src={stage.image}
                alt={stage.imageAlt}
                width={stage.imageWidth}
                height={stage.imageHeight}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-[var(--color-teal)]">
                {stage.eyebrow}
              </div>
              <h3 class="mt-1 text-xl font-semibold text-[var(--color-ink)]">{stage.label}</h3>
              <p class="mt-4 font-semibold text-[var(--color-ink)]">{stage.hero.name}</p>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{stage.hero.why}</p>
              <div class="mt-4 pt-4 border-t border-slate-900/10">
                <div class="font-mono text-[10px] tracking-[0.1em] uppercase text-slate-600 mb-2">
                  Also on bench
                </div>
                <ul class="space-y-1 text-sm text-slate-600 leading-relaxed">
                  {stage.secondary.map((item) => (
                    <li>· {item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-xs text-slate-500 font-mono">
      Full inventory (~80 items) available on request.
    </p>

    <figure class="mt-14">
      <img
        src="/assets/images/ldc-interior-iso2.png"
        alt="An isometric cutaway illustration of the BioKEA Berkeley lab, showing extraction, prep, quantification, and sequencing equipment arranged along the pipeline flow."
        width="1448"
        height="1086"
        class="w-full rounded-md block"
        loading="lazy"
      />
      <figcaption class="mt-3 font-mono text-[10px] tracking-[0.14em] uppercase text-slate-500">
        Fig · LDC interior, stage-by-stage
      </figcaption>
    </figure>

    <figure class="mt-14 grid md:grid-cols-[1.2fr_1fr] gap-8 items-start">
      <img
        src="/assets/images/lab-diversityscanner.jpg"
        alt="DiversityScanner — a roboticized specimen-imaging platform"
        width="800"
        height="645"
        class="w-full rounded-md border border-slate-900/10"
        loading="lazy"
      />
      <div>
        <Eyebrow>DIVERSITYSCANNER · ARRIVING EARLY SUMMER <time datetime="2026">2026</time></Eyebrow
        >
        <h3 class="mt-3 text-xl font-semibold">Roboticized species discovery</h3>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          A collaborative imaging platform for high-throughput specimen screening. BioKEA is
          adopting a unit as part of the California Institute for Biodiversity (CIB) collaborative
          expansion — arriving on site in <time datetime="2026-06">early summer 2026</time>.
          Computer-vision models generate interpretable attention heatmaps that reveal which
          morphological features drive each species assignment, feeding validated specimens into the
          LDC molecular pipeline.
        </p>
        <img
          src="/assets/images/diversityscanner-heatmaps-cream.webp"
          alt="Four specimen panels overlaid with topographic-style attention contours in the BioKEA cream palette."
          width="800"
          height="600"
          class="mt-4 w-full rounded-sm border border-slate-900/10"
          loading="lazy"
        />
      </div>
    </figure>
  </section>

  <CtaBand
    title="Route samples through the LDC."
    subtitle="Molecular sequencing as a service for eDNA and biodiversity customers. We also take pipeline integration and capability-development conversations."
    cta={{ href: '/contact?topic=sequencing', label: 'Get in touch' }}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={stringifyJsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': ['ResearchOrganization', 'LocalBusiness'],
          '@id': 'https://biokea.ai/lab#lab',
          name: 'BioKEA Large Data Collider',
          alternateName: 'BioKEA LDC',
          url: 'https://biokea.ai/lab',
          parentOrganization: { '@id': 'https://biokea.ai/#org' },
          description:
            'A 5,000+ sq ft combined wet-lab and compute platform in Berkeley, California. BioKEA runs molecular sequencing as a service out of the LDC, targeted at environmental-DNA (eDNA) and biodiversity-omics customers.',
          areaServed: ['California', 'United States'],
          foundingDate: '2025-09',
          location: { '@id': 'https://biokea.ai/lab#place' },
          knowsAbout: [
            'Environmental DNA',
            'Metabarcoding',
            'DNA barcoding',
            'Long-read nanopore sequencing',
            'Oxford Nanopore Promethion 2',
            'Biodiversity informatics',
            'FAIR data',
          ],
          makesOffer: [
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'eDNA and metabarcoding',
                serviceType: 'Molecular sequencing service',
                description:
                  'Water, soil, and sediment samples routed through extraction, amplification, quantification, and long-read or amplicon sequencing. Delivered as a FAIR data package (DwC-A, NCBI SRA, GBIF, Zenodo).',
                audience: {
                  '@type': 'BusinessAudience',
                  audienceType:
                    'Conservation nonprofits, state and federal agencies, academic labs, environmental consultancies',
                },
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'DNA barcoding surveys',
                serviceType: 'Molecular sequencing service',
                description:
                  'Amplicon sequencing on the ONT Promethion 2 across COI, 16S, 18S, ITS, rbcL, matK, and custom primers.',
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Long-read microbial genomics',
                serviceType: 'Molecular sequencing service',
                description:
                  'Whole-genome, metagenomic, and hybrid assemblies on the Oxford Nanopore Promethion 2.',
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Pipeline integration',
                serviceType: 'Bioinformatics service',
                description:
                  'Bespoke sample-to-claim workflows with integrated taxonomy reconciliation, QC, and FAIR packaging.',
              },
            },
          ],
        },
        {
          '@type': 'Place',
          '@id': 'https://biokea.ai/lab#place',
          name: 'BioKEA Berkeley Lab',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Berkeley',
            addressRegion: 'CA',
            addressCountry: 'US',
          },
        },
      ],
    })}
  />

  <script is:inline>
    (() => {
      const slider = document.querySelector('[data-lab-slider]');
      if (!slider) return;
      const slides = Array.from(slider.querySelectorAll('[data-slide]'));
      const dots = Array.from(slider.querySelectorAll('[data-slider-dot]'));
      const caption = slider.querySelector('[data-slider-caption]');
      if (slides.length === 0) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const INTERVAL_MS = 4500;
      let current = 0;
      let timer = null;
      let paused = false;

      const show = (index) => {
        slides.forEach((img, i) => {
          img.style.opacity = i === index ? '1' : '0';
        });
        dots.forEach((dot, i) => {
          dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
          dot.style.opacity = i === index ? '1' : '0.5';
        });
        const next = slides[index];
        if (caption && next) {
          const text = next.getAttribute('data-caption') || '';
          caption.textContent = text;
        }
        current = index;
      };

      const advance = () => show((current + 1) % slides.length);

      const start = () => {
        if (reduceMotion || paused || timer) return;
        timer = window.setInterval(advance, INTERVAL_MS);
      };
      const stop = () => {
        if (timer) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const target = Number(dot.getAttribute('data-slider-dot'));
          if (Number.isFinite(target)) show(target);
          stop();
          start();
        });
      });

      slider.addEventListener('mouseenter', () => {
        paused = true;
        stop();
      });
      slider.addEventListener('mouseleave', () => {
        paused = false;
        start();
      });
      slider.addEventListener('focusin', () => {
        paused = true;
        stop();
      });
      slider.addEventListener('focusout', () => {
        paused = false;
        start();
      });

      start();
    })();
  </script>
</BaseLayout>
