---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { env } from 'cloudflare:workers';
import { SupabaseDb } from '@/lib/payments/db';
import { shopifyConfigured } from '@/lib/payments/shopify-env';
import { panelView } from '@/lib/payments/panel';
import { usdCents } from '@/lib/payments/terms';
import type { PaymentRecord, QuoteRecord } from '@/lib/payments/types';

export const prerender = false;

const { token } = Astro.params;
const e = env as unknown as {
  SUPABASE_URL?: string;
  SUPABASE_SERVICE_ROLE_KEY?: string;
  SHOPIFY_STORE_DOMAIN?: string;
  SHOPIFY_ADMIN_TOKEN?: string;
  SHOPIFY_CLIENT_ID?: string;
  SHOPIFY_CLIENT_SECRET?: string;
};

// UUID shape check first — avoids a pointless round trip on junk tokens.
const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(token ?? '');

let quote: QuoteRecord | null = null;
let payments: PaymentRecord[] = [];
if (isUuid && e?.SUPABASE_URL && e?.SUPABASE_SERVICE_ROLE_KEY) {
  // Service role: the quotes table has no anonymous select policy. The page
  // renders on the Worker, so this key is never exposed to the client.
  const db = new SupabaseDb(e.SUPABASE_URL, e.SUPABASE_SERVICE_ROLE_KEY);
  try {
    quote = await db.getQuoteByToken(token!);
    if (quote) payments = await db.listPayments(quote.id);
  } catch (err) {
    console.error('[quote] read failed', err);
    return new Response('Quote service unavailable — please try again shortly.', { status: 503 });
  }
}

if (!quote) return new Response('Quote not found', { status: 404 });

const usd = (n: number) => '$' + n.toLocaleString('en-US');
const fmtDate = (iso: string) => iso.slice(0, 10);
const expired = Date.parse(quote.expires_at) < Date.now();
const panel = panelView(quote, payments, new Date());
const paymentsLive = shopifyConfigured(e ?? {}); // hide the offer if Shopify isn't configured on this deployment
const payFlash = Astro.url.searchParams.get('pay'); // 'unavailable' | 'failed' | 'attest' | 'invoiced' | null
// After a bounce the buyer's selections come back as query params so the
// panel is prefilled — nobody should have to pick the rate twice.
const keptAudience = Astro.url.searchParams.get('audience');
const keptPo = Astro.url.searchParams.get('po') ?? '';
---

<BaseLayout
  title={`Quote ${quote.quote_number} — BioKEA`}
  description="BioKEA sequencing quote."
  noindex
>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-8">
    <Eyebrow>QUOTE {quote.quote_number}</Eyebrow>
    <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">
      Sequencing quote
    </h1>
    {quote.organization && <p class="mt-2 text-slate-600">Prepared for {quote.organization}</p>}
    <p class="mt-1 font-mono text-[11px] tracking-[0.1em] uppercase text-slate-500">
      Issued {fmtDate(quote.created_at)} · {expired ? 'Expired' : 'Valid until'}
      {!expired && fmtDate(quote.expires_at)}
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-10">
    {
      expired && (
        <p class="mb-6 text-sm text-[var(--color-ink)] bg-[rgba(190,24,93,0.08)] border-l-2 border-[var(--color-pink)] rounded-r-sm px-4 py-3 leading-relaxed print:block">
          <strong>This quote has expired.</strong> Pricing and availability may have changed —
          please request a current quote before submitting a purchase order.
        </p>
      )
    }
    <table
      class="w-full border-collapse bg-white border border-slate-900/10 rounded-md overflow-hidden"
    >
      <thead>
        <tr class="bg-[var(--color-ink)] text-white text-left">
          <th class="px-4 py-3 text-[13px] font-semibold">Service</th>
          {
            quote.audience ? (
              <th class="px-4 py-3 text-[13px] font-semibold text-right">
                {quote.audience === 'academic' ? 'Academic' : 'Commercial'}
              </th>
            ) : (
              <>
                <th class="px-4 py-3 text-[13px] font-semibold text-right">Academic</th>
                <th class="px-4 py-3 text-[13px] font-semibold text-right">Commercial</th>
              </>
            )
          }
        </tr>
      </thead>
      <tbody>
        {
          quote.lines.map((l) => (
            <tr class="border-t border-slate-900/10">
              <td class="px-4 py-4 text-sm text-[var(--color-ink)]">
                <div class="font-semibold">{l.serviceTitle}</div>
                <div class="text-xs text-slate-500 mt-1">
                  {l.count.toLocaleString()} {l.unitLabel}s
                  {l.markers > 1 && ` · ${l.markers} markers`}
                </div>
              </td>
              {quote.audience !== 'commercial' && (
                <td class="px-4 py-4 text-sm font-mono text-right whitespace-nowrap align-top">
                  {usd(l.academic.total)}
                  <div class="mt-1 font-sans text-[11px] font-normal text-slate-500 whitespace-normal">
                    {l.academic.tierRange} tier
                    {l.academic.freeHeadroom > 0 &&
                      ` · ships up to ${l.academic.pricedCount.toLocaleString()}`}
                  </div>
                </td>
              )}
              {quote.audience !== 'academic' && (
                <td class="px-4 py-4 text-sm font-mono text-right whitespace-nowrap align-top">
                  {usd(l.commercial.total)}
                  <div class="mt-1 font-sans text-[11px] font-normal text-slate-500 whitespace-normal">
                    {l.commercial.tierRange} tier
                    {l.commercial.freeHeadroom > 0 &&
                      ` · ships up to ${l.commercial.pricedCount.toLocaleString()}`}
                  </div>
                </td>
              )}
            </tr>
          ))
        }
        <tr class="border-t-2 border-slate-900/20 bg-[var(--color-cream)]">
          <td class="px-4 py-4 text-sm font-semibold text-[var(--color-ink)]">Total</td>
          {
            quote.audience !== 'commercial' && (
              <td class="px-4 py-4 font-mono font-semibold text-right">
                {usd(quote.total_academic)}
              </td>
            )
          }
          {
            quote.audience !== 'academic' && (
              <td class="px-4 py-4 font-mono font-semibold text-right">
                {usd(quote.total_commercial)}
              </td>
            )
          }
        </tr>
      </tbody>
    </table>

    {
      quote.needs_conversation && (
        <p class="mt-5 text-sm text-[var(--color-ink)] bg-[rgba(146,64,14,0.1)] border-l-2 border-[var(--color-ochre)] rounded-r-sm px-4 py-3 leading-relaxed">
          At this volume, figures are indicative. We'll confirm sequencing capacity, timeline, and
          final pricing before anything is committed.
        </p>
      )
    }

    {
      payFlash === 'failed' && (
        <p class="mt-5 text-sm text-[var(--color-ink)] bg-[rgba(190,24,93,0.08)] border-l-2 border-[var(--color-pink)] rounded-r-sm px-4 py-3 leading-relaxed print:hidden">
          <strong>Payment service unavailable.</strong> Your quote is unaffected — please try again
          in a few minutes.
        </p>
      )
    }
    {
      payFlash === 'unavailable' && (
        <p class="mt-5 text-sm text-[var(--color-ink)] bg-[rgba(146,64,14,0.1)] border-l-2 border-[var(--color-ochre)] rounded-r-sm px-4 py-3 leading-relaxed print:hidden">
          This quote can't be paid online right now. Email{' '}
          <a class="underline" href="mailto:contact@biokea.ai">
            contact@biokea.ai
          </a>{' '}
          and we'll sort it out.
        </p>
      )
    }
    {
      payFlash === 'attest' && (
        <p class="mt-5 text-sm text-[var(--color-ink)] bg-[rgba(146,64,14,0.1)] border-l-2 border-[var(--color-ochre)] rounded-r-sm px-4 py-3 leading-relaxed print:hidden">
          <strong>One more step:</strong> to use the academic / nonprofit rate, tick the attestation
          box below — or choose the commercial rate.
        </p>
      )
    }
    {
      payFlash === 'invoiced' && (
        <p class="mt-5 text-sm text-[var(--color-ink)] bg-[rgba(15,118,110,0.08)] border-l-2 border-[var(--color-teal)] rounded-r-sm px-4 py-3 leading-relaxed print:hidden">
          Invoice sent to {quote.email} — forward it to purchasing, or pay it online with the button
          below.
        </p>
      )
    }

    {
      panel.kind === 'offer' && paymentsLive && (
        <section
          id="pay"
          class="mt-8 p-5 bg-[var(--color-cream)] border border-slate-900/10 rounded-md print:hidden"
        >
          <p class="font-mono text-[11px] tracking-[0.1em] uppercase text-slate-500">
            Start this project
          </p>
          <h2 class="mt-1 text-lg font-semibold text-[var(--color-ink)]">Pay in full</h2>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            You'll get a Shopify invoice you can pay by card, Shop Pay, or PayPal — or forward it to
            accounts payable.
          </p>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Pay in full to lock your rate and reserve lab capacity. Your quoted per-sample rate is
            held for this project. Send fewer samples than quoted and the unused amount stays as
            credit toward another project for 12 months; send more and we invoice the difference at
            the same rate. See our{' '}
            <a href="/terms" class="underline">
              terms
            </a>
            .
          </p>
          <form
            method="post"
            action={`/api/quote/${quote.access_token}/pay`}
            class="mt-4 space-y-3 text-sm"
          >
            {panel.audience ? (
              <>
                <input type="hidden" name="audience" value={panel.audience} />
                <p class="text-sm text-[var(--color-ink)]">
                  <strong>
                    {panel.audience === 'academic'
                      ? 'Academic / nonprofit rate'
                      : 'Commercial rate'}
                  </strong>{' '}
                  —{' '}
                  {usdCents(
                    panel.audience === 'academic'
                      ? panel.amountAcademicCents
                      : panel.amountCommercialCents,
                  )}
                </p>
              </>
            ) : (
              <>
                <label class="flex items-start gap-2">
                  <input
                    type="radio"
                    name="audience"
                    value="commercial"
                    required
                    class="mt-1"
                    checked={keptAudience === 'commercial'}
                  />
                  <span>
                    <strong>Commercial rate</strong> — {usdCents(panel.amountCommercialCents)}
                  </span>
                </label>
                <label class="flex items-start gap-2">
                  <input
                    type="radio"
                    name="audience"
                    value="academic"
                    required
                    class="mt-1"
                    checked={keptAudience === 'academic'}
                  />
                  <span>
                    <strong>Academic / nonprofit rate</strong> —{' '}
                    {usdCents(panel.amountAcademicCents)}
                  </span>
                </label>
              </>
            )}
            {(panel.audience ? panel.needsAttestation : true) && (
              <label class="flex items-start gap-2 pl-6 text-xs text-slate-600">
                <input type="checkbox" name="attest" value="true" class="mt-0.5" />
                <span>
                  Required for the academic rate: this work is for a degree-granting institution,
                  government agency, or non-profit research organization.
                </span>
              </label>
            )}
            <div class="flex flex-wrap items-end gap-3 pt-1">
              <label class="block">
                <span class="text-xs text-slate-600">
                  PO number (optional — printed on the invoice)
                </span>
                <input
                  name="po_number"
                  value={keptPo}
                  maxlength="64"
                  class="mt-1 w-full max-w-xs border border-slate-300 rounded px-2 py-1.5 font-mono"
                />
              </label>
              <button
                type="submit"
                name="intent"
                value="pay"
                class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2.5 rounded-sm text-sm font-medium"
              >
                Continue to checkout →
              </button>
              <button
                type="submit"
                name="intent"
                value="invoice"
                class="px-4 py-2.5 rounded-sm text-sm font-medium border border-slate-900/20 bg-white text-[var(--color-ink)]"
              >
                Email me a Net-30 invoice instead
              </button>
            </div>
          </form>
        </section>
      )
    }
    <!--
      Progressive enhancement for the offer form above: the server
      (POST /api/quote/[token]/pay) is the authoritative check for the
      academic attestation, but toggling `required` client-side lets the
      browser's native validation catch a missed checkbox before the round
      trip. A no-op when the offer panel isn't rendered (`#pay` won't
      exist) or when the radios are absent — the single-audience path
      renders a hidden `audience` input instead of radios, so there is
      nothing to key the toggle off. Left unconditional rather than nested
      inside the `panel.kind === 'offer'` block above because Prettier's
      Astro parser mis-tokenizes multi-brace script bodies nested inside a
      JSX curly-expression.
    -->
    <script>
      const form = document.querySelector<HTMLFormElement>('#pay form');
      const attest = form && form.querySelector<HTMLInputElement>('input[name="attest"]');
      const radios = form
        ? form.querySelectorAll<HTMLInputElement>('input[type="radio"][name="audience"]')
        : null;
      if (form && attest && radios && radios.length > 0) {
        radios.forEach((radio) => {
          radio.addEventListener('change', () => {
            attest.required = radio.value === 'academic' && radio.checked;
          });
        });
      }
    </script>
    {
      panel.kind === 'invoiced' && (
        <section class="mt-8 p-5 bg-[var(--color-cream)] border border-slate-900/10 rounded-md">
          <p class="font-mono text-[11px] tracking-[0.1em] uppercase text-slate-500">
            {panel.phase === 'deposit' ? 'Invoice' : 'Balance invoice'}
          </p>
          <p class="mt-1 text-sm text-[var(--color-ink)]">
            {panel.phase === 'deposit' ? 'Invoice' : 'Balance invoice'} for{' '}
            <strong>{usdCents(panel.amountCents)}</strong> sent to {quote.email}
            {panel.dueAt && ` — due ${fmtDate(panel.dueAt)}`}.
          </p>
          <div class="mt-3 flex gap-3 print:hidden">
            {panel.hostedUrl && (
              <a
                href={panel.hostedUrl}
                class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2 rounded-sm text-sm font-medium"
              >
                Pay now →
              </a>
            )}
            {panel.pdfUrl && (
              <a
                href={panel.pdfUrl}
                class="px-4 py-2 rounded-sm text-sm font-medium border border-slate-900/20 bg-white"
              >
                Invoice PDF
              </a>
            )}
          </div>
        </section>
      )
    }
    {
      panel.kind === 'deposit_paid' && (
        <section class="mt-8 p-5 bg-[var(--color-cream)] border border-slate-900/10 rounded-md">
          <p class="font-mono text-[11px] tracking-[0.1em] uppercase text-slate-500">
            Payment received
          </p>
          <p class="mt-1 text-sm text-[var(--color-ink)]">
            Payment of <strong>{usdCents(panel.amountCents)}</strong> received in full on{' '}
            {fmtDate(panel.paidAt)}. The lab will send shipping instructions and your sample
            manifest within 2 business days.
          </p>
          {panel.pdfUrl && (
            <a
              href={panel.pdfUrl}
              class="mt-3 inline-block text-sm underline text-[var(--color-teal)] print:hidden"
            >
              Receipt / invoice PDF
            </a>
          )}
        </section>
      )
    }
    {
      panel.kind === 'paid' && (
        <section class="mt-8 p-5 bg-[var(--color-cream)] border border-slate-900/10 rounded-md">
          <p class="font-mono text-[11px] tracking-[0.1em] uppercase text-slate-500">
            Paid in full
          </p>
          <p class="mt-1 text-sm text-[var(--color-ink)]">Thank you — this project is settled.</p>
          {panel.creditCents && panel.creditExpiresAt && (
            <p class="mt-2 text-sm text-[var(--color-ink)]">
              {usdCents(panel.creditCents)} credit toward a future project, valid until{' '}
              {fmtDate(panel.creditExpiresAt)}. Mention quote {quote.quote_number} and we'll apply
              it.
            </p>
          )}
          <div class="mt-3 flex gap-4 text-sm print:hidden">
            {panel.depositPdf && (
              <a href={panel.depositPdf} class="underline text-[var(--color-teal)]">
                Invoice PDF
              </a>
            )}
            {panel.balancePdf && (
              <a href={panel.balancePdf} class="underline text-[var(--color-teal)]">
                Balance invoice PDF
              </a>
            )}
          </div>
        </section>
      )
    }

    <div class="mt-6 text-xs text-slate-500 leading-relaxed">
      <p>
        Academic/nonprofit rates require eligible institutional status, attested when you pay. Your
        quoted per-sample rate is held for this project — see{' '}
        <a href="/terms" class="underline">terms</a>. Turnaround is typically 4–8 weeks from sample
        receipt.
      </p>
      <p class="mt-2">
        Questions? <a href="mailto:contact@biokea.ai" class="text-[var(--color-teal)] underline"
          >contact@biokea.ai</a
        > · BioKEA · Berkeley, CA
      </p>
    </div>

    {
      !expired && (
        <button
          type="button"
          onclick="window.print()"
          class="mt-8 bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2.5 rounded-sm text-sm font-medium print:hidden"
        >
          Print / save as PDF
        </button>
      )
    }
  </section>

  <style is:global>
    @media print {
      nav,
      footer,
      a[href='#main'] {
        display: none !important;
      }
      body {
        background: #fff;
      }
    }
  </style>
</BaseLayout>
