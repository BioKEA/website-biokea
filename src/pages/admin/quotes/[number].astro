---
// src/pages/admin/quotes/[number].astro — one quote: lines, payments,
// and the balance form (preview → confirm). Spec §5.3.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ConfigSummary from '@/components/ui/ConfigSummary.astro';
import { env } from 'cloudflare:workers';
import { SupabaseDb } from '@/lib/payments/db';
import {
  computeBalance,
  paidInFull,
  paymentLines,
  paymentTotalCents,
  usdCents,
} from '@/lib/payments/terms';
import { parseBalanceForm } from '@/lib/payments/balance-form';
import {
  DEFAULT_DAYS,
  FIRM_ROW_TYPES,
  MAX_DAYS,
  finaliseFrom,
  formRows,
  parseFinaliseForm,
  priceFirm,
  submittedRows,
  type FormRow,
} from '@/lib/payments/finalise';
import type { Quote } from '@/lib/pricing/quote';
import { lineKey } from '@/lib/pricing/quote';
import { numericId } from '@/lib/payments/shopify-ids';
import { statusLabel } from '@/lib/payments/labels';
import type { PaymentRecord, QuoteRecord } from '@/lib/payments/types';

export const prerender = false;

if (!Astro.locals.adminEmail) return new Response('Forbidden', { status: 403 });

const e = env as {
  SUPABASE_URL?: string;
  SUPABASE_SERVICE_ROLE_KEY?: string;
  SHOPIFY_STORE_HANDLE?: string;
};
const storeHandle = e.SHOPIFY_STORE_HANDLE ?? 'biokea';
const shopifyAdminUrl = (path: string) => `https://admin.shopify.com/store/${storeHandle}/${path}`;
// A malformed external_id (shouldn't happen, but this is a display-only
// admin page) must not 500 the whole quote view — just render no link.
const safeNumericId = (gid: string): string | null => {
  try {
    return numericId(gid);
  } catch {
    return null;
  }
};
const number = Astro.params.number ?? '';
if (!/^BK-\d{4}-\d{4,}$/.test(number) || !e?.SUPABASE_URL || !e?.SUPABASE_SERVICE_ROLE_KEY) {
  return new Response('Quote not found', { status: 404 });
}
const db = new SupabaseDb(e.SUPABASE_URL, e.SUPABASE_SERVICE_ROLE_KEY);
let found: QuoteRecord | null;
let payments: PaymentRecord[];
try {
  found = await db.getQuoteByNumber(number);
  payments = found ? await db.listPayments(found.id) : [];
} catch (err) {
  console.error('[admin] read failed', err);
  return new Response('Quote service unavailable — please try again shortly.', { status: 503 });
}
if (!found) return new Response('Quote not found', { status: 404 });
const quote: QuoteRecord = found;
const deposit = payments.find((p) => p.kind === 'deposit' && p.status === 'paid') ?? null;

const url = Astro.url;
const flash = {
  error: url.searchParams.get('error'),
  finalised: url.searchParams.get('finalised'),
  balance: url.searchParams.get('balance'),
  // A settlement comes back as exactly one of these. `credit` means the
  // quote paid in full and bought under the credit terms; `refund` means a
  // legacy part-payment settled under the old terms and staff owe cash.
  credit: url.searchParams.get('credit'),
  refund: url.searchParams.get('refund'),
};
// Computed here, not inline in the template. Also: in a `[number].astro`
// route Astro's generated per-file types shadow the global `Number`
// identifier, so this uses unary `+` (identical string-to-number coercion)
// instead of calling `Number(...)`, and the global `isFinite` (equivalent
// to `Number.isFinite` once the argument is already a number) instead of
// `Number.isFinite`.
const money = (v: string | null) => (isFinite(+(v ?? '')) ? usdCents(+(v ?? '0')) : '—');
const creditDisplay = money(flash.credit);
const refundDisplay = money(flash.refund);

// Preview: the balance endpoint bounced the form back to us as query params.
let preview: ReturnType<typeof computeBalance> | null = null;
let previewError: string | null = null;
let previewInputs = new URLSearchParams();
if (url.searchParams.get('preview') === '1' && deposit && quote.audience) {
  previewInputs = url.searchParams;
  const parsed = parseBalanceForm(url.searchParams);
  if (!parsed) previewError = 'Counts must be positive whole numbers.';
  else {
    try {
      preview = computeBalance(
        parsed.inputs,
        quote.audience,
        {
          amountCents: deposit.amount_cents,
          invoiceLabel: deposit.order_ref
            ? `order ${deposit.order_ref}`
            : (deposit.external_id ?? 'deposit'),
          paidAt: deposit.paid_at ?? deposit.created_at,
        },
        quote.lines,
      );
    } catch (err) {
      previewError = err instanceof Error ? err.message : 'Invalid configuration.';
    }
  }
}
const canBalance = quote.status === 'deposit_paid' && deposit !== null && quote.audience !== null;
const val = (k: string) => previewInputs.get(k) ?? '';

// Firm quote (spec 3): shown for consult quotes, legacy volume quotes, and
// quotes the lab firmed up and may still revise — never once paid.
const firmFrom = finaliseFrom(quote, payments);
const firmPreviewing = url.searchParams.get('preview') === 'finalise';
let firmRows: [number, FormRow][] = formRows(quote.lines).map((r, i) => [i, r]);
let firmErrors: Record<string, string> = {};
let firmPreview: Quote | null = null;
let firmDays = String(DEFAULT_DAYS);
let firmNote = quote.lab_note ?? '';
if (firmFrom && firmPreviewing) {
  firmRows = [...submittedRows(url.searchParams).entries()];
  firmDays = url.searchParams.get('days') ?? firmDays;
  firmNote = url.searchParams.get('note') ?? '';
  const parsed = parseFinaliseForm(url.searchParams);
  if (!parsed.ok) firmErrors = parsed.errors;
  else {
    const priced = priceFirm(parsed.inputs);
    if (priced.ok) firmPreview = priced.quote;
    else firmErrors = { rows: priced.error };
  }
}
const rowType = (v: string) => FIRM_ROW_TYPES.find((t) => t.value === v);

// 'deposit_paid' covers both a new pay-in-full quote and a legacy 50%
// deposit still awaiting a balance invoice — both write kind:'deposit'
// (frozen ledger name), so the amount alone can't tell them apart. Same
// comparison as panelView() in src/lib/payments/panel.ts. null audience
// (legacy, pre-configurator quote) means there is no rate to compare
// against, so this says so rather than guessing.
let depositPaidQualifier: string | null = null;
if (quote.status === 'deposit_paid' && deposit) {
  const full = paidInFull(quote, deposit);
  if (full === null) {
    depositPaidQualifier = 'cannot confirm paid-in-full — no rate recorded on this quote';
  } else {
    const expectedTotalCents = paymentTotalCents(paymentLines(quote.lines, quote.audience!));
    depositPaidQualifier = full
      ? 'paid in full'
      : `only ${usdCents(deposit.amount_cents)} of ${usdCents(expectedTotalCents)} paid — balance still owed`;
  }
}
---

<BaseLayout title={`Admin — ${quote.quote_number} — BioKEA`} description="Internal." noindex>
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-12">
    <p class="text-xs">
      <a class="underline text-[var(--color-teal)]" href="/admin">← All quotes</a>
    </p>
    <Eyebrow>ADMIN · {quote.quote_number}</Eyebrow>
    <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em] text-[var(--color-ink)]">
      {quote.organization ?? quote.name}
    </h1>
    <p class="mt-1 text-sm text-slate-600">
      {quote.name} · <a class="underline" href={`mailto:${quote.email}`}>{quote.email}</a>
    </p>
    <p class="mt-1 font-mono text-[11px] tracking-[0.1em] uppercase text-slate-500">
      status {statusLabel(quote.status)}{depositPaidQualifier ? ` (${depositPaidQualifier})` : ''} · rate
      {quote.audience ?? '—'} · PO {quote.po_number ?? '—'} · source {quote.source ?? '—'} · valid to
      {quote.expires_at.slice(0, 10)}
      · <a class="underline" href={`/quote/${quote.access_token}`}>customer view</a>
    </p>
    {
      quote.finalised_at && (
        <p data-admin-finalised class="mt-1 text-xs text-slate-600">
          Firm quote by {quote.finalised_by ?? '—'} on {quote.finalised_at.slice(0, 10)}
          {quote.consult_triggers.length > 0 &&
            ` · consult reasons: ${quote.consult_triggers.map((t) => t.label).join(', ')}`}
        </p>
      )
    }

    {
      quote.config && (
        <section data-admin-config>
          <ConfigSummary
            config={quote.config}
            triggers={quote.consult_triggers}
            directions={quote.directions}
            consult={quote.status === 'consult'}
            staff
          />
        </section>
      )
    }

    {
      flash.error && (
        <p class="mt-6 text-sm text-red-700 border-l-2 border-red-700 pl-3">
          {flash.error === 'state' &&
            'The quote is not ready for a balance (needs a completed payment, still awaiting samples).'}
          {flash.error === 'input' && 'Those counts could not be priced — check the numbers.'}
          {flash.error === 'gateway' &&
            'Shopify rejected the invoice. Nothing was recorded; try again.'}
        </p>
      )
    }
    {
      flash.error?.startsWith('finalise-') && (
        <p class="mt-6 text-sm text-red-700 border-l-2 border-red-700 pl-3">
          {flash.error === 'finalise-state' &&
            'This quote can no longer be firmed up here — it changed, or a payment exists on it. Nothing was saved.'}
          {flash.error === 'finalise-db' &&
            'The firm quote could not be saved. Check that migration 0010 is applied, then try again.'}
          {flash.error === 'finalise-input' && 'The form could not be read. Try again.'}
        </p>
      )
    }
    {
      flash.finalised === 'sent' && (
        <p class="mt-6 text-sm text-green-800 border-l-2 border-green-700 pl-3">
          Firm quote saved and emailed to {quote.email}. The customer can pay from the quote page.
        </p>
      )
    }
    {
      flash.finalised === 'email-failed' && (
        <p class="mt-6 text-sm text-amber-800 border-l-2 border-amber-600 pl-3">
          Firm quote saved, but <strong>the email to {quote.email} did not go out</strong>. Send
          them the customer view link yourself.
        </p>
      )
    }
    {
      flash.balance === 'invoiced' && (
        <p class="mt-6 text-sm text-green-800 border-l-2 border-green-700 pl-3">
          Balance invoice sent.
        </p>
      )
    }
    {
      flash.balance === 'settled' &&
        (flash.credit === '0' || flash.refund === '0' ? (
          <p class="mt-6 text-sm text-amber-800 border-l-2 border-amber-600 pl-3">
            Nothing further owed — actual counts matched what was paid. Nothing to return.
          </p>
        ) : flash.refund !== null ? (
          <p class="mt-6 text-sm text-amber-800 border-l-2 border-amber-600 pl-3">
            Nothing further owed — actual counts came in under what was paid. This quote paid a
            part-payment under the older deposit terms, so it settles in cash:{' '}
            <strong>refund {refundDisplay} in Shopify</strong> — Orders → the payment order →
            Refund. The customer has been emailed to expect it.
          </p>
        ) : (
          <p class="mt-6 text-sm text-amber-800 border-l-2 border-amber-600 pl-3">
            Nothing further owed — actual counts came in under what was paid.{' '}
            <strong>{creditDisplay} credit recorded</strong>, valid 12 months. No refund is issued;
            apply it as a fixed-amount discount on their next draft order.
          </p>
        ))
    }

    <h2 class="mt-8 text-lg font-semibold">Quoted lines</h2>
    <table class="mt-2 w-full text-sm border-collapse bg-white border border-slate-900/10">
      <thead
        ><tr class="bg-slate-100 text-left"
          ><th class="px-3 py-2">Service</th><th class="px-3 py-2 text-right">Quoted count</th><th
            class="px-3 py-2 text-right">Academic</th
          ><th class="px-3 py-2 text-right">Commercial</th></tr
        ></thead
      >
      <tbody
        >{
          quote.lines.map((l) => (
            <tr class="border-t border-slate-900/10">
              <td class="px-3 py-2">
                {l.serviceTitle}
                {l.markers > 1 ? ` × ${l.markers} markers` : ''}
              </td>
              <td class="px-3 py-2 text-right font-mono">
                {l.count.toLocaleString('en-US')} {l.unitLabel}s
              </td>
              <td class="px-3 py-2 text-right font-mono">{usdCents(l.academic.total * 100)}</td>
              <td class="px-3 py-2 text-right font-mono">{usdCents(l.commercial.total * 100)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2 class="mt-8 text-lg font-semibold">Payments</h2>
    {
      payments.length === 0 ? (
        <p class="mt-2 text-sm text-slate-500">None yet.</p>
      ) : (
        <table class="mt-2 w-full text-sm border-collapse bg-white border border-slate-900/10">
          <thead>
            <tr class="bg-slate-100 text-left">
              <>
                <th class="px-3 py-2">Kind</th>
                <th class="px-3 py-2">Status</th>
                <th class="px-3 py-2 text-right">Amount</th>
                <th class="px-3 py-2">Due</th>
                <th class="px-3 py-2">Paid</th>
                <th class="px-3 py-2">Links</th>
                <th class="px-3 py-2">By</th>
              </>
            </tr>
          </thead>
          <tbody>
            {payments.map((p) => (
              <tr class="border-t border-slate-900/10">
                <td class="px-3 py-2">{p.kind}</td>
                <td class="px-3 py-2 font-mono text-xs">{p.status}</td>
                <td class="px-3 py-2 text-right font-mono">{usdCents(p.amount_cents)}</td>
                <td class="px-3 py-2">{p.due_at?.slice(0, 10) ?? '—'}</td>
                <td class="px-3 py-2">{p.paid_at?.slice(0, 10) ?? '—'}</td>
                <td class="px-3 py-2 text-xs">
                  {p.hosted_url && (
                    <a class="underline" href={p.hosted_url}>
                      hosted
                    </a>
                  )}{' '}
                  {p.pdf_url && (
                    <a class="underline" href={p.pdf_url}>
                      pdf
                    </a>
                  )}{' '}
                  {p.external_id && safeNumericId(p.external_id) && (
                    <a
                      class="underline"
                      href={shopifyAdminUrl(`draft_orders/${safeNumericId(p.external_id)}`)}
                    >
                      shopify draft
                    </a>
                  )}{' '}
                  {p.external_order_id && (
                    <a class="underline" href={shopifyAdminUrl(`orders/${p.external_order_id}`)}>
                      shopify order
                    </a>
                  )}
                </td>
                <td class="px-3 py-2 text-xs">{p.created_by ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }

    {
      firmFrom && (
        <section
          id="firm"
          data-admin-firm
          class="mt-10 p-5 bg-[var(--color-cream)] border border-slate-900/10 rounded-md"
        >
          <h2 class="text-lg font-semibold">
            {quote.finalised_at ? 'Revise the firm quote' : 'Firm quote'}
          </h2>
          <p class="mt-1 text-sm text-slate-600">
            Set the lines the customer will pay for. Rate-card lines are priced by the engine at
            both rates; a custom line takes the price you agree (academic blank = same as
            commercial). Confirming saves the quote as payable and emails {quote.email} a link.
          </p>
          <form
            method="post"
            action={`/api/admin/quotes/${quote.quote_number}/finalise`}
            class="mt-4"
          >
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-left text-xs text-slate-500">
                    <>
                      <th class="py-1 pr-2">Line</th>
                      <th class="py-1 pr-2">Count</th>
                      <th class="py-1 pr-2">Markers</th>
                      <th class="py-1 pr-2">Custom title</th>
                      <th class="py-1 pr-2">Unit</th>
                      <th class="py-1 pr-2">Academic $/unit</th>
                      <th class="py-1">Commercial $/unit</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {firmRows.map(([i, r]) => {
                    const name = (f: string) => `rows[${i}][${f}]`;
                    const err = (f: string) => firmErrors[name(f)];
                    const rowErrors = [
                      'type',
                      'count',
                      'markers',
                      'title',
                      'unit',
                      'academic',
                      'commercial',
                    ]
                      .map(err)
                      .filter(Boolean);
                    const input =
                      'border border-slate-300 rounded px-2 py-1 font-mono bg-white aria-[invalid=true]:border-red-600';
                    return (
                      <>
                        <tr>
                          <td class="py-1 pr-2">
                            <select
                              name={name('type')}
                              aria-label={`Line ${i + 1} type`}
                              aria-invalid={err('type') ? 'true' : undefined}
                              class="max-w-[14rem] border border-slate-300 rounded px-2 py-1 bg-white"
                            >
                              <option value="">—</option>
                              {FIRM_ROW_TYPES.map((t) => (
                                <option value={t.value} selected={t.value === r.type}>
                                  {t.label}
                                </option>
                              ))}
                            </select>
                          </td>
                          <td class="py-1 pr-2">
                            <input
                              name={name('count')}
                              aria-label={`Line ${i + 1} count`}
                              aria-invalid={err('count') ? 'true' : undefined}
                              inputmode="numeric"
                              value={r.count}
                              class={`w-20 ${input}`}
                            />
                          </td>
                          <td class="py-1 pr-2">
                            <input
                              name={name('markers')}
                              aria-label={`Line ${i + 1} markers`}
                              aria-invalid={err('markers') ? 'true' : undefined}
                              inputmode="numeric"
                              value={r.markers}
                              placeholder={rowType(r.type)?.markers === false ? '—' : '1'}
                              class={`w-14 ${input}`}
                            />
                          </td>
                          <td class="py-1 pr-2">
                            <input
                              name={name('title')}
                              aria-label={`Line ${i + 1} custom title`}
                              aria-invalid={err('title') ? 'true' : undefined}
                              maxlength="120"
                              value={r.title}
                              class={`w-40 ${input} font-sans`}
                            />
                          </td>
                          <td class="py-1 pr-2">
                            <input
                              name={name('unit')}
                              aria-label={`Line ${i + 1} unit`}
                              aria-invalid={err('unit') ? 'true' : undefined}
                              maxlength="24"
                              value={r.unit}
                              placeholder="kit"
                              class={`w-20 ${input} font-sans`}
                            />
                          </td>
                          <td class="py-1 pr-2">
                            <input
                              name={name('academic')}
                              aria-label={`Line ${i + 1} academic price per unit`}
                              aria-invalid={err('academic') ? 'true' : undefined}
                              inputmode="decimal"
                              value={r.academic}
                              class={`w-20 ${input}`}
                            />
                          </td>
                          <td class="py-1">
                            <input
                              name={name('commercial')}
                              aria-label={`Line ${i + 1} commercial price per unit`}
                              aria-invalid={err('commercial') ? 'true' : undefined}
                              inputmode="decimal"
                              value={r.commercial}
                              class={`w-20 ${input}`}
                            />
                          </td>
                        </tr>
                        {rowErrors.length > 0 && (
                          <tr>
                            <td colspan="7" class="pb-2 text-xs text-red-700" role="alert">
                              Line {i + 1}: {rowErrors.join(' ')}
                            </td>
                          </tr>
                        )}
                      </>
                    );
                  })}
                </tbody>
              </table>
            </div>

            <div class="mt-4 grid gap-4 sm:grid-cols-[10rem_1fr]">
              <label class="text-sm">
                Days valid
                <input
                  name="days"
                  inputmode="numeric"
                  value={firmDays}
                  aria-invalid={firmErrors.days ? 'true' : undefined}
                  aria-describedby="firm-days-help"
                  class="mt-1 block w-24 border border-slate-300 rounded px-2 py-1 font-mono bg-white"
                />
                <span id="firm-days-help" class="block mt-1 text-xs text-slate-500">
                  From today, up to {MAX_DAYS}.
                </span>
              </label>
              <label class="text-sm">
                Note to the customer (optional; shown on their quote page and in the email)
                <textarea
                  name="note"
                  rows="3"
                  maxlength="2000"
                  aria-invalid={firmErrors.note ? 'true' : undefined}
                  class="mt-1 block w-full border border-slate-300 rounded px-2 py-1 bg-white"
                  set:text={firmNote}
                />
              </label>
            </div>

            {(firmErrors.rows || firmErrors.days || firmErrors.note) && (
              <p class="mt-3 text-sm text-red-700" role="alert">
                {[firmErrors.rows, firmErrors.days, firmErrors.note].filter(Boolean).join(' ')}
              </p>
            )}
            {firmPreview && (
              <div class="mt-4 text-sm">
                <table class="w-full border-collapse bg-white border border-slate-900/10">
                  <thead>
                    <tr class="bg-slate-100 text-left">
                      <>
                        <th class="px-3 py-1">Line</th>
                        <th class="px-3 py-1 text-right">Academic</th>
                        <th class="px-3 py-1 text-right">Commercial</th>
                      </>
                    </tr>
                  </thead>
                  <tbody>
                    {firmPreview.lines.map((l) => (
                      <tr class="border-t border-slate-900/10">
                        <td class="px-3 py-1">
                          {l.serviceTitle} — {l.count.toLocaleString('en-US')} {l.unitLabel}s
                          {l.markers > 1 ? ` × ${l.markers} markers` : ''}
                          <span class="text-xs text-slate-500">
                            {` (${l.commercial.tierRange}${l.commercial.freeHeadroom > 0 ? `, priced as ${l.commercial.pricedCount.toLocaleString('en-US')}` : ''})`}
                          </span>
                        </td>
                        <td class="px-3 py-1 text-right font-mono">
                          {usdCents(l.academic.total * 100)}
                        </td>
                        <td class="px-3 py-1 text-right font-mono">
                          {usdCents(l.commercial.total * 100)}
                        </td>
                      </tr>
                    ))}
                    <tr class="border-t-2 border-slate-900/20 font-semibold">
                      <td class="px-3 py-2">Total</td>
                      <td class="px-3 py-2 text-right font-mono">
                        {usdCents(firmPreview.total.academic * 100)}
                      </td>
                      <td class="px-3 py-2 text-right font-mono">
                        {usdCents(firmPreview.total.commercial * 100)}
                      </td>
                    </tr>
                  </tbody>
                </table>
                <p class="mt-2 text-slate-600">
                  Confirming saves this as {quote.audience ? `a ${quote.audience}-rate` : 'a'}{' '}
                  payable quote and emails {quote.email}.
                </p>
              </div>
            )}

            <div class="mt-4 flex gap-3">
              <button
                type="submit"
                name="confirm"
                value=""
                class="px-4 py-2 rounded-sm text-sm font-medium border border-slate-900/20 bg-white"
              >
                Preview
              </button>
              {firmPreview && (
                <button
                  type="submit"
                  name="confirm"
                  value="true"
                  class="px-4 py-2 rounded-sm text-sm font-medium bg-[var(--color-ink)] text-[var(--color-cream)]"
                >
                  Confirm &amp; email customer
                </button>
              )}
            </div>
          </form>
        </section>
      )
    }
    {
      canBalance && (
        <section class="mt-10 p-5 bg-[var(--color-cream)] border border-slate-900/10 rounded-md">
          <h2 class="text-lg font-semibold">Issue balance invoice</h2>
          <p class="mt-1 text-sm text-slate-600">
            Enter the counts actually received and QC-passed. Priced at the{' '}
            <strong>{quote.audience}</strong> rate; the payment of{' '}
            <strong>{usdCents(deposit!.amount_cents)}</strong> is credited.
          </p>
          <form
            method="post"
            action={`/api/admin/quotes/${quote.quote_number}/balance`}
            class="mt-4"
          >
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left">
                  <>
                    <th class="py-1">Service</th>
                    <th class="py-1 text-right">Quoted</th>
                    <th class="py-1">Actual count</th>
                    <th class="py-1">Markers</th>
                  </>
                </tr>
              </thead>
              <tbody>
                {quote.lines.map((l) => (
                  <tr>
                    <td class="py-1 pr-3">{l.serviceTitle}</td>
                    <td class="py-1 pr-3 text-right font-mono">
                      {l.count.toLocaleString('en-US')}
                    </td>
                    <td class="py-1 pr-3">
                      <input
                        name={`counts[${lineKey(l)}]`}
                        inputmode="numeric"
                        pattern="[0-9]*"
                        value={val(`counts[${lineKey(l)}]`) || String(l.count)}
                        class="w-28 border border-slate-300 rounded px-2 py-1 font-mono"
                      />
                    </td>
                    <td class="py-1">
                      {l.serviceSlug === 'metabarcoding' || l.serviceSlug === 'barcoding' ? (
                        <input
                          name={`markers[${lineKey(l)}]`}
                          inputmode="numeric"
                          pattern="[0-9]*"
                          value={val(`markers[${lineKey(l)}]`) || String(l.markers)}
                          class="w-16 border border-slate-300 rounded px-2 py-1 font-mono"
                        />
                      ) : (
                        <span class="text-slate-400">—</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            {previewError && <p class="mt-3 text-sm text-red-700">{previewError}</p>}
            {preview && (
              <div class="mt-4 text-sm">
                <table class="w-full border-collapse bg-white border border-slate-900/10">
                  <tbody>
                    {preview.lines.map((l) => (
                      <tr class="border-t border-slate-900/10">
                        <td class="px-3 py-1">{l.description}</td>
                        <td class="px-3 py-1 text-right font-mono">{usdCents(l.amountCents)}</td>
                      </tr>
                    ))}
                    <tr class="border-t border-slate-900/10 text-slate-500">
                      <td class="px-3 py-1">{preview.credit.title}</td>
                      <td class="px-3 py-1 text-right font-mono">
                        − {usdCents(preview.credit.amountCents)}
                      </td>
                    </tr>
                    <tr class="border-t-2 border-slate-900/20 font-semibold">
                      <td class="px-3 py-2">Balance due</td>
                      <td class="px-3 py-2 text-right font-mono">
                        {usdCents(preview.balanceCents)}
                      </td>
                    </tr>
                  </tbody>
                </table>
                {preview.uncapped.length > 0 && (
                  <p class="mt-2 text-amber-800">
                    ⚠ {preview.uncapped.join(', ')} — no matching quote line (service or marker
                    count changed), so these are priced at current rates rather than the rate the
                    customer locked.
                  </p>
                )}
                {preview.balanceCents <= 0 ? (
                  <p class="mt-2 text-amber-800">
                    Nothing owed. Confirming records a settlement and marks the quote paid; you then
                    record {usdCents(-preview.balanceCents)} as credit.
                  </p>
                ) : (
                  <p class="mt-2 text-slate-600">
                    Confirming creates and emails the balance invoice for{' '}
                    {usdCents(preview.balanceCents)}.
                  </p>
                )}
              </div>
            )}

            <div class="mt-4 flex gap-3">
              <button
                type="submit"
                name="confirm"
                value=""
                class="px-4 py-2 rounded-sm text-sm font-medium border border-slate-900/20 bg-white"
              >
                Preview
              </button>
              {preview && (
                <button
                  type="submit"
                  name="confirm"
                  value="true"
                  class="px-4 py-2 rounded-sm text-sm font-medium bg-[var(--color-ink)] text-[var(--color-cream)]"
                >
                  Confirm &amp; {preview.balanceCents <= 0 ? 'settle' : 'send invoice'}
                </button>
              )}
            </div>
          </form>
        </section>
      )
    }
  </section>
</BaseLayout>
