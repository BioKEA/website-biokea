---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { projects } from '@/data/projects';
import { stringifyJsonLd } from '@/lib/json-ld';

const live = projects.filter((p) => p.status === 'live');
const revealing = projects.filter((p) => p.status === 'revealing-soon');
const coming = projects.filter((p) => p.status === 'coming-soon');

const tallies = {
  live: live.length,
  revealing: revealing.length,
  coming: coming.length,
};
---

<BaseLayout
  title="Projects"
  description="Active and forthcoming BioKEA projects — interactive tools, datasets, and collaborations."
>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-8">
    <Eyebrow>PROJECTS</Eyebrow>
    <h1
      class="mt-3 text-4xl md:text-5xl font-semibold tracking-[-0.025em] leading-[1.05] text-[var(--color-ink)] max-w-[24ch]"
    >
      What we're shipping.
    </h1>
    <p class="mt-5 max-w-[60ch] text-slate-600 leading-relaxed">
      Live tools, datasets, and analyses produced by BioKEA — alongside the forthcoming work our
      partners have asked us to keep under wraps a little longer.
    </p>
    <div class="mt-6 flex gap-3 flex-wrap font-mono text-[11px] tracking-[0.08em] uppercase">
      <span class="text-[var(--color-teal)]">
        {tallies.live} LIVE
      </span>
      <span class="text-slate-400">·</span>
      <span class="text-[var(--color-ochre)]">
        {tallies.revealing} REVEALING SOON
      </span>
      <span class="text-slate-400">·</span>
      <span class="text-slate-500">
        {tallies.coming} COMING SOON
      </span>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <CtaBand
    title="Have a project that belongs here?"
    subtitle="We're taking collaboration, contract, and funding conversations."
    cta={{ href: '/contact', label: 'Start a conversation' }}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={stringifyJsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'SoftwareApplication',
          '@id': 'https://biokea.ai/projects#intertidal-gap',
          name: 'Intertidal Biodiversity DNA Barcode Library',
          applicationCategory: 'Biodiversity analysis tool',
          operatingSystem: 'Web',
          url: 'https://biokea.shinyapps.io/california_intertidal_gap_analysis/',
          description:
            'A reference barcode taxonomic coverage gap analysis tool — 4,384 intertidal species along the California coast, cross-referenced against BOLD, NCBI GenBank, NCBI SRA, and GBIF.',
          creator: { '@id': 'https://biokea.ai/mission#sean' },
          provider: { '@id': 'https://biokea.ai/#org' },
          sponsor: { '@id': 'https://biokea.ai/#partner-coastalquest' },
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
          about: [
            { '@type': 'DefinedTerm', name: 'DNA barcoding' },
            { '@type': 'DefinedTerm', name: 'Intertidal biodiversity' },
            { '@type': 'DefinedTerm', name: 'California coastal ecology' },
          ],
        },
        {
          '@type': 'Dataset',
          '@id': 'https://biokea.ai/projects#california-insect-barcoding',
          name: 'California Insect Barcoding Initiative',
          description:
            "The first large-scale DNA-barcode survey of California insects — over 1 million specimens barcoded, estimating a conservative minimum of ~61,000 species statewide with roughly one third still undiscovered. Originated independently of BioKEA as Austin Baker's prior research program; now continued under the BioKEA umbrella.",
          creator: { '@id': 'https://biokea.ai/mission#austin' },
          creativeWorkStatus: 'In preparation',
          about: [
            { '@type': 'DefinedTerm', name: 'Insecta' },
            { '@type': 'DefinedTerm', name: 'California biodiversity' },
            { '@type': 'DefinedTerm', name: 'DNA barcoding' },
          ],
        },
        {
          '@type': 'Dataset',
          '@id': 'https://biokea.ai/projects#bay-estuary-metabarcoding',
          name: 'Bay estuary metabarcoding baseline',
          description:
            'A longitudinal metabarcoding baseline for the San Francisco Bay estuary, in partnership with the San Francisco Estuary Institute.',
          creator: [
            { '@id': 'https://biokea.ai/mission#michelle' },
            { '@id': 'https://biokea.ai/mission#sean' },
          ],
          publisher: { '@id': 'https://biokea.ai/#org' },
          creativeWorkStatus: 'In preparation',
          about: [
            { '@type': 'DefinedTerm', name: 'Metabarcoding' },
            { '@type': 'DefinedTerm', name: 'San Francisco Bay estuary' },
            { '@type': 'DefinedTerm', name: 'Environmental DNA' },
          ],
        },
        {
          '@type': 'Dataset',
          '@id': 'https://biokea.ai/projects#long-read-microbial',
          name: 'Long-read microbial genome resource',
          description:
            'A growing library of high-quality long-read microbial assemblies produced on the Oxford Nanopore Promethion 2 and published as a public resource.',
          creator: { '@id': 'https://biokea.ai/mission#sean' },
          publisher: { '@id': 'https://biokea.ai/#org' },
          creativeWorkStatus: 'In preparation',
          about: [
            { '@type': 'DefinedTerm', name: 'Long-read sequencing' },
            { '@type': 'DefinedTerm', name: 'Microbial genomics' },
            { '@type': 'DefinedTerm', name: 'Oxford Nanopore' },
          ],
        },
        {
          '@type': 'SoftwareSourceCode',
          '@id': 'https://biokea.ai/projects#colloquip',
          name: 'Colloquip',
          description:
            "An open-source multi-agent AI deliberation platform. Specialized scientific personas — Biology, Chemistry, ADMET, Clinical, Regulatory, Red Team — self-organize to debate hypotheses. Originated and maintained independently by Sunit Jain on GitHub; surfaced through Sunit's BioKEA advisor role, not authored by BioKEA.",
          codeRepository: 'https://github.com/sunitj/Colloquip',
          programmingLanguage: 'Python',
          license: 'https://github.com/sunitj/Colloquip/blob/main/LICENSE',
          author: { '@id': 'https://biokea.ai/mission#sunit' },
          about: [
            { '@type': 'DefinedTerm', name: 'Multi-agent AI' },
            { '@type': 'DefinedTerm', name: 'Scientific reasoning' },
          ],
        },
      ],
    })}
  />
</BaseLayout>
