---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { Image } from 'astro:assets';
import { stringifyJsonLd } from '@/lib/json-ld';
import previewGallery from '@/assets/images/agentis-previews/gallery.webp';
import previewLanding from '@/assets/images/agentis-previews/landing.webp';
import previewDashboard from '@/assets/images/agentis-previews/dashboard.webp';
import previewPeerReview from '@/assets/images/agentis-previews/peer-review.webp';
import previewBlueskyFeed from '@/assets/images/agentis-previews/bluesky-feed.webp';
import previewMobileField from '@/assets/images/agentis-previews/mobile-field.webp';

const previews = [
  {
    img: previewGallery,
    eyebrow: '00 · OVERVIEW',
    title: 'Five surfaces, one sequenced flow',
    caption: 'A tour of how a researcher moves through Agentis — from landing to field collection.',
    mobile: false,
  },
  {
    img: previewLanding,
    eyebrow: '01 · LANDING',
    title: 'AT-Protocol entry',
    caption:
      'Dark-bold marketing entry. Sign in with your AT Protocol identity; the knowledge graph greets you.',
    mobile: false,
  },
  {
    img: previewDashboard,
    eyebrow: '02 · WORKSPACE',
    title: 'Connected platforms dashboard',
    caption:
      'GBIF biodiversity map, Tree-of-Life canvas, AT Proto / Semble / HypGen connections, Platform Pulse, activity feed.',
    mobile: false,
  },
  {
    img: previewPeerReview,
    eyebrow: '03 · PEER REVIEW',
    title: 'Multi-marker eDNA review',
    caption:
      'AI pre-screen plus verified-human checks. Weighted transparent scoring; review signed to an AT-Protocol record.',
    mobile: false,
  },
  {
    img: previewBlueskyFeed,
    eyebrow: '04 · DISTRIBUTION',
    title: 'Agentis Science · Bluesky feed',
    caption:
      'Publications surface alongside reviewer commentary and data-package references on a custom Bluesky feed.',
    mobile: false,
  },
  {
    img: previewMobileField,
    eyebrow: '05 · FIELD',
    title: 'Mobile sample collection',
    caption:
      'Phone-first capture: location, environmental conditions, photos — streamed straight into the data package.',
    mobile: true,
  },
];

const concepts = [
  {
    eyebrow: '01 · Review',
    title: 'AI pre-screen + verified human review',
    body: 'AI pre-screens manuscript structure and methodology in hours. Verified AT Protocol human experts evaluate contextual scientific nuance. Weighted, transparent scoring replaces opaque editorial gatekeeping.',
  },
  {
    eyebrow: '02 · Publish',
    title: 'StoryMaps, not dead PDFs',
    body: 'Every publication is an explorable digital artifact, permanently tethered to its underlying FAIR data package. Sequences land in NCBI SRA, occurrences in GBIF, archives in Zenodo — cited inline, always reachable.',
  },
  {
    eyebrow: '03 · Trust',
    title: 'Built on open protocols',
    body: 'Every publication is a signed AT Protocol record. Every peer review is verifiable. Data provenance is cryptographic. The infrastructure is as open as the science it carries.',
  },
];
---

<BaseLayout
  title="Agentis — coming soon"
  description="An AI-first scientific journal built on the AT Protocol. Fast, verifiable peer review and publications as interactive StoryMaps."
  ogImage="/assets/images/og-agentis.jpg"
>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-10">
    <div class="grid md:grid-cols-[1.4fr_1fr] gap-10 items-center">
      <div>
        <Eyebrow>AGENTIS · COMING SOON</Eyebrow>
        <h1
          class="mt-3 text-4xl md:text-5xl font-semibold tracking-[-0.025em] leading-[1.05] text-[var(--color-ink)] max-w-[24ch]"
        >
          An AI-first scientific journal, built on the AT Protocol.
        </h1>
        <p class="mt-5 max-w-[60ch] text-slate-600 leading-relaxed">
          Fast, verifiable peer review on the AT Protocol (the decentralized social-web protocol
          that underpins Bluesky). Publications as interactive StoryMaps. FAIR (Findable,
          Accessible, Interoperable, Reusable) data packages that never go stale. Launching at
          <span class="font-mono text-sm text-[var(--color-teal)]">agentis.science</span>.
        </p>
        <p class="mt-4 max-w-[60ch] text-sm text-slate-500 leading-relaxed italic">
          Agentis is in early development. The early-access list is open below; we'll notify
          subscribers when there's something to show.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <a
            href="/contact?topic=agentis"
            class="bg-[var(--color-ink)] text-[var(--color-cream)] px-4 py-2.5 rounded-sm text-sm font-medium"
          >
            Get early access updates
          </a>
          <a href="#design-previews" class="text-[var(--color-teal)] text-sm font-medium">
            See design previews →
          </a>
        </div>
      </div>
      <figure class="relative">
        <img
          src="/assets/images/agentis-discourse-graph.webp"
          alt="A lattice of interconnected signed publication nodes illustrating verifiable peer review and transparent scientific discourse."
          width="1200"
          height="1200"
          class="w-full max-w-[420px] ml-auto block"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid md:grid-cols-3 gap-6">
      {
        concepts.map((c) => (
          <article class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md p-6">
            <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-[var(--color-teal)]">
              {c.eyebrow}
            </div>
            <h2 class="mt-2 text-lg font-semibold text-[var(--color-ink)]">{c.title}</h2>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{c.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="design-previews" class="max-w-6xl mx-auto px-6 py-12 scroll-mt-24">
    <Eyebrow>DESIGN PREVIEWS</Eyebrow>
    <h2
      class="mt-3 text-2xl font-semibold tracking-[-0.015em] max-w-[34ch] text-[var(--color-ink)]"
    >
      Five surfaces in the working prototype.
    </h2>
    <p class="mt-3 max-w-[62ch] text-slate-600 leading-relaxed">
      Static screenshots of the in-progress Agentis interface. Visual direction only — the live
      product will iterate from here.
    </p>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      {
        previews.map((p) => (
          <article class="bg-[var(--color-cream-warm)] border border-slate-900/10 rounded-md overflow-hidden flex flex-col">
            <div
              class={`agentis-zoom group relative bg-[#09090b] overflow-hidden ${p.mobile ? 'flex items-center justify-center py-6' : ''}`}
              data-mobile={p.mobile ? 'true' : 'false'}
            >
              <Image
                src={p.img}
                alt={p.title}
                widths={p.mobile ? [400, 600, 780] : [900, 1400, 2000, 2560]}
                sizes={
                  p.mobile ? '(min-width: 768px) 560px, 100vw' : '(min-width: 768px) 1120px, 100vw'
                }
                loading="lazy"
                class={`agentis-zoom-img ${p.mobile ? 'h-auto max-h-[460px] w-auto' : 'block w-full h-auto'}`}
              />
              <span
                aria-hidden="true"
                class="pointer-events-none absolute top-2 right-2 font-mono text-[9px] tracking-[0.14em] uppercase text-[var(--color-cream)]/70 bg-black/40 border border-white/10 rounded-sm px-1.5 py-0.5 opacity-0 group-hover:opacity-100 transition-opacity"
              >
                Hover · pan to zoom
              </span>
            </div>
            <div class="p-5">
              <div class="font-mono text-[10px] tracking-[0.14em] uppercase text-[var(--color-teal)]">
                {p.eyebrow}
              </div>
              <h3 class="mt-1.5 text-base font-semibold text-[var(--color-ink)]">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{p.caption}</p>
            </div>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-xs text-slate-500 italic">
      These are design previews captured from interactive HTML mockups, not the live product. The
      final Agentis experience may differ.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <figure>
      <img
        src="/assets/images/agentis-storymap-mockup-squiggles-contained.png"
        alt="A mockup of an Agentis StoryMap: an interactive scientific publication with map, data, FAIR package badges, inline citations, and contained editorial squiggle annotations."
        width="1600"
        height="1100"
        class="w-full block rounded-md"
        loading="lazy"
      />
      <figcaption
        class="mt-3 text-center font-mono text-[10px] tracking-[0.14em] uppercase text-slate-500"
      >
        Fig · not a dead PDF
      </figcaption>
    </figure>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <Eyebrow>WHY NOW</Eyebrow>
    <h2 class="mt-3 text-2xl font-semibold max-w-[30ch]">
      The bottleneck was never data generation.
    </h2>
    <p class="mt-3 max-w-[62ch] text-slate-600 leading-relaxed">
      It is the editorial, verification, and distribution layer that turns raw data into trustworthy
      scientific claims. Agentis is the output end of the BioKEA pipeline — the layer where raw
      FASTA becomes a verifiable, cite-able scientific artifact.
    </p>
  </section>

  <CtaBand
    title="Get notified when Agentis launches."
    subtitle="We'll be in touch when the first issue goes live."
    cta={{ href: '/contact?topic=agentis', label: 'Send us a line' }}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={stringifyJsonLd({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      '@id': 'https://biokea.ai/agentis#app',
      name: 'Agentis',
      applicationCategory: 'Scientific publishing platform',
      operatingSystem: 'Web',
      url: 'https://biokea.ai/agentis',
      description:
        'An AI-first open-access scientific journal built on the AT Protocol. Multi-agent AI pre-screen plus verified human peer review with transparent weighted scoring. Publications render as interactive StoryMaps tethered to their FAIR data packages.',
      creator: { '@id': 'https://biokea.ai/#org' },
      provider: { '@id': 'https://biokea.ai/#org' },
      releaseNotes: 'Coming soon — launching at agentis.science.',
      featureList: [
        'AI pre-screen of manuscript structure and methodology',
        'Verified human peer review via AT Protocol DIDs',
        'Publications as interactive StoryMaps, not PDFs',
        'FAIR-compliant data package tethering (GBIF, NCBI SRA, Zenodo)',
        'Cryptographically signed peer-review records',
      ],
    })}
  />

  <style is:global>
    /* Cursor-tracked pan-zoom for the Agentis design previews.
       The container sets --zx / --zy on pointer move (0% – 100%);
       transform-origin reads them so the zoomed image pans toward
       the cursor. Falls back to centered scale when not hovered. */
    .agentis-zoom-img {
      transform: scale(1);
      transform-origin: var(--zx, 50%) var(--zy, 50%);
      transition:
        transform 200ms ease-out,
        transform-origin 80ms linear;
      will-change: transform;
    }
    .agentis-zoom:hover .agentis-zoom-img {
      transform: scale(2);
    }
    @media (prefers-reduced-motion: reduce) {
      .agentis-zoom-img {
        transition: none;
      }
      .agentis-zoom:hover .agentis-zoom-img {
        transform: scale(1);
      }
    }
    .agentis-zoom {
      cursor: zoom-in;
    }
  </style>

  <script is:inline>
    (() => {
      const containers = document.querySelectorAll('.agentis-zoom');
      containers.forEach((el) => {
        const onMove = (e) => {
          const rect = el.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          el.style.setProperty('--zx', x + '%');
          el.style.setProperty('--zy', y + '%');
        };
        const onLeave = () => {
          el.style.setProperty('--zx', '50%');
          el.style.setProperty('--zy', '50%');
        };
        el.addEventListener('pointermove', onMove);
        el.addEventListener('pointerleave', onLeave);
      });
    })();
  </script>
</BaseLayout>
