---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Thesis from '@/components/sections/Thesis.astro';
import Evidence from '@/components/sections/Evidence.astro';
import Ecosystem from '@/components/sections/Ecosystem.astro';
import Origin from '@/components/sections/Origin.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { partners } from '@/data/partners';
import { homepageStats } from '@/data/stats';
import { programs } from '@/data/credentials';
import { stringifyJsonLd } from '@/lib/json-ld';

const ecosystemTiles = [
  {
    image: '/assets/images/Pillar3-Droplet.webp',
    imageAlt: 'Droplet — aquatic eDNA and metabarcoding specialist',
    label: 'Field to species',
    name: 'Droplet',
    description:
      'An aquatic eDNA specialist — sample collection, metabarcoding, and taxonomic identification.',
  },
  {
    image: '/assets/images/Pillar1-BioinfoOS.webp',
    imageAlt: 'BioinfoOS — compute layer',
    label: 'Compute layer',
    name: 'BioinfoOS',
    description: 'Software on the LDC. AI-assisted pipelines, developed in-house.',
  },
  {
    image: '/assets/images/Pillar2-Agentis.webp',
    imageAlt: 'Agentis — publishing',
    label: 'Publish',
    name: 'Agentis',
    description: 'Open-access publishing on AT Protocol. Coming soon.',
    href: '/agentis',
    external: false,
    linkLabel: 'agentis.science',
  },
];
---

<BaseLayout
  title="BioKEA — Biology, decoded in the public interest"
  description="A 5,000+ sq ft open lab and an AI pipeline from soil sample to published claim — built for the commons."
  preloadImage="/assets/images/BioKEA-Large-Data-Collider.webp"
  preloadImageType="image/webp"
>
  <Hero
    eyebrow="BIOKEA // BERKELEY, CA"
    headline="Biology, decoded in the public interest."
    subheadline="A 5,000+ sq ft open lab in Berkeley and an AI pipeline from soil sample to published claim — built for the commons. BioKEA operates the Large Data Collider, a compute + wet-lab platform for biodiversity and environmental omics, and runs molecular sequencing as a service for eDNA and related customers."
    ctaPrimary={{ href: '/lab', label: "See what we're building" }}
    ctaSecondary={{ href: '/contact', label: 'Schedule a call' }}
    badgeImage="/assets/images/BioKEA-Large-Data-Collider.webp"
    badgeAlt="BioKEA Large Data Collider — a circular editorial illustration of the compute + wet-lab collision engine"
    badgeCaptionEyebrow="Fig · The Large Data Collider"
    badgeCaptionBody="Two strands of biology converge at a single spark of synthesis. Orbital tracks carry packetized data marks across an AI lattice of nodes; directional chevrons set the flow; barcode-like omics ticks frame the rim. The field, the lab, the journal, the archive — our instrument for verifiable public-interest science, from sample to published claim."
  />

  <Thesis
    eyebrow="MISSION"
    quote="The bottleneck in modern biology is no longer data generation. It is scientific storytelling and synthesis. BioKEA is an AI company with a wet-lab moat."
    attribution="— BioKEA thesis"
  />

  <Evidence
    eyebrow="CAPABILITY · THE LDC"
    title="The Large Data Collider"
    body="A 5,000+ sq ft Berkeley lab housing an ONT Promethion 2 sequencer and a growing suite of extraction and prep automation. Designed as shared infrastructure with California Institute for Biodiversity."
    photoSrc="/assets/images/lab-warehouse-after.jpg"
    photoAlt="Berkeley lab interior, operational"
    photoWidth={800}
    photoHeight={767}
    photoCaption="BERKELEY · 5,000+ SQ FT"
    stats={homepageStats}
  />

  <Ecosystem eyebrow="ECOSYSTEM" title="What we're building" tiles={ecosystemTiles} />

  <Origin
    eyebrow="ORIGIN"
    title="Founded in March 2025."
    paragraphs={[
      'BioKEA — Biology Knowledge Exploration Assistant — is an independent lab and AI platform for biodiversity and environmental omics, based in Berkeley, California.',
      'The team builds on years at the DOE Berkeley Lab network, in marine research, and in Bay Area environmental consulting. The Berkeley space came online in March 2026.',
    ]}
    partners={partners}
  />

  <CtaBand
    title="Collaborate, fund, or plug into the pipeline."
    subtitle="We're actively taking partnership and capabilities conversations."
    cta={{ href: '/contact', label: 'Schedule a call' }}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={stringifyJsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://biokea.ai/#org',
          name: 'BioKEA',
          alternateName: 'Biology Knowledge Exploration Assistant',
          url: 'https://biokea.ai',
          logo: 'https://biokea.ai/assets/images/logo2.png',
          description:
            'BioKEA is an AI company with a wet-lab moat — a 5,000+ sq ft Berkeley lab plus an AI pipeline from field sample to verifiable scientific claim, built for the commons. BioKEA runs molecular sequencing as a service for environmental-DNA and biodiversity-omics customers.',
          foundingDate: '2025-03',
          founder: { '@id': 'https://biokea.ai/mission#sean' },
          member: [
            { '@id': 'https://biokea.ai/mission#sean' },
            { '@id': 'https://biokea.ai/mission#michelle' },
            { '@id': 'https://biokea.ai/mission#austin' },
            { '@id': 'https://biokea.ai/mission#sunit' },
            { '@id': 'https://biokea.ai/mission#greg' },
          ],
          knowsAbout: [
            'Environmental DNA',
            'Metabarcoding',
            'Biodiversity informatics',
            'DNA barcoding',
            'Long-read nanopore sequencing',
            'Oxford Nanopore Promethion 2',
            'FAIR data',
            'Darwin Core Archive',
            'AT Protocol',
            'Open-access publishing',
          ],
          memberOf: programs.map((p) => ({
            '@type': 'Organization',
            name: p.name,
            url: p.url,
          })),
          location: { '@id': 'https://biokea.ai/lab#place' },
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Berkeley',
            addressRegion: 'CA',
            addressCountry: 'US',
          },
          makesOffer: [
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Molecular sequencing as a service',
                serviceType: 'eDNA and metabarcoding, DNA barcoding, long-read microbial genomics',
                description:
                  'Full sample-to-claim molecular sequencing service for environmental-DNA and biodiversity-omics customers, delivered as a FAIR-compliant data package.',
                provider: { '@id': 'https://biokea.ai/#org' },
              },
            },
          ],
          contactPoint: {
            '@type': 'ContactPoint',
            email: 'contact@biokea.ai',
            contactType: 'Partnerships / capabilities / funding',
          },
          sameAs: ['https://bsky.app/profile/biokea.bsky.social'],
        },
        {
          '@type': 'Organization',
          '@id': 'https://biokea.ai/#partner-cib',
          name: 'California Institute for Biodiversity',
          url: 'https://www.calalive.org/',
        },
        {
          '@type': 'Organization',
          '@id': 'https://biokea.ai/#partner-sfei',
          name: 'San Francisco Estuary Institute',
          url: 'https://www.sfei.org/',
        },
        {
          '@type': 'Organization',
          '@id': 'https://biokea.ai/#partner-coastalquest',
          name: 'Coastal Quest',
          url: 'https://www.coastalquest.org/',
        },
      ],
    })}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={stringifyJsonLd({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': 'https://biokea.ai/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is BioKEA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'An independent biology company in Berkeley, California — Biology Knowledge Exploration Assistant. AI company with a wet-lab moat: a 5,000+ sq ft Berkeley lab plus an AI pipeline from field sample to verifiable scientific claim, built for the commons.',
          },
        },
        {
          '@type': 'Question',
          name: 'What services does BioKEA offer?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Molecular sequencing as a service for environmental-DNA and biodiversity-omics customers: eDNA and metabarcoding (primary), DNA barcoding surveys, long-read microbial genomics, specimen screening (DiversityScanner, summer 2026), and bespoke sample-to-claim pipeline integration.',
          },
        },
        {
          '@type': 'Question',
          name: "Where is BioKEA's lab?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Large Data Collider (LDC) is a 5,000+ sq ft facility in Berkeley, California, operational from March 2026, housing an Oxford Nanopore Promethion 2 and ~80 instruments across extraction, prep, quantification, and sequencing stages.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I engage BioKEA for a sequencing project?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Reach out via the contact form at biokea.ai/contact. Engagement routes include partnership/collaboration, capabilities/lab work, funding, and Agentis early access.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is Agentis?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Agentis is BioKEA's forthcoming AI-first open-access scientific journal on the AT Protocol, launching at agentis.science. Publication is structured as interactive StoryMaps tied to FAIR data packages, not dead PDFs.",
          },
        },
        {
          '@type': 'Question',
          name: 'Who supports BioKEA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'BioKEA is supported by the cloud and AI infrastructure programs AWS for Startups, Google Cloud for Startups, and NVIDIA Inception. Major partner: California Institute for Biodiversity. Collaborations with the San Francisco Estuary Institute and Coastal Quest.',
          },
        },
      ],
    })}
  />
</BaseLayout>
