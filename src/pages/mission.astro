---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Portrait from '@/components/ui/Portrait.astro';
import PartnerMark from '@/components/ui/PartnerMark.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import ProgramsStrip from '@/components/sections/ProgramsStrip.astro';
import { team } from '@/data/team';
import { partners } from '@/data/partners';
import { milestones } from '@/data/milestones';
import { stringifyJsonLd } from '@/lib/json-ld';
import { credentialsFor } from '@/data/credentials';
---

<BaseLayout
  title="Mission & team"
  description="BioKEA — Biology Knowledge Exploration Assistant. Founded March 2025 in Berkeley to build public-interest biology infrastructure."
>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-10">
    <Eyebrow>MISSION</Eyebrow>
    <h1
      class="mt-3 text-4xl md:text-5xl font-semibold tracking-[-0.025em] leading-[1.05] text-[var(--color-ink)] max-w-[24ch]"
    >
      The bottleneck is storytelling. We're building the commons that fixes it.
    </h1>
    <div class="mt-6 max-w-[62ch] text-slate-600 leading-relaxed space-y-4">
      <p>
        Modern biology produces more data every month than it can credibly synthesize. The gap is
        not instrumentation; it is the editorial, verification, and distribution layer that turns
        raw data into trustworthy scientific claims.
      </p>
      <p>
        BioKEA — <em>Biology Knowledge Exploration Assistant</em> — exists to build that layer as public
        infrastructure: an open lab, an open pipeline, and an open publishing output.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <Eyebrow>TEAM</Eyebrow>
    <div class="grid md:grid-cols-3 gap-5 mt-6">
      {
        team
          .filter((p) => p.tier !== 'advisor')
          .map((p) => (
            <div>
              <Portrait
                src={p.image}
                alt={p.alt}
                name={p.name}
                role={p.role}
                postNominal={p.postNominal}
                credentials={credentialsFor(p.name)
                  .filter((c) => !c.hideOnPortrait)
                  .map((c) => c.label)}
              />
              {p.bio && <p class="mt-3 text-xs text-slate-600 leading-relaxed">{p.bio}</p>}
            </div>
          ))
      }
    </div>

    <div class="mt-12">
      <Eyebrow>ADVISORS</Eyebrow>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 max-w-3xl">
        {
          team
            .filter((p) => p.tier === 'advisor')
            .map((p) => (
              <div>
                <Portrait
                  src={p.image}
                  alt={p.alt}
                  name={p.name}
                  role={p.role}
                  postNominal={p.postNominal}
                  credentials={credentialsFor(p.name)
                    .filter((c) => !c.hideOnPortrait)
                    .map((c) => c.label)}
                  size="sm"
                />
                {p.bio && <p class="mt-2 text-[10px] text-slate-600 leading-snug">{p.bio}</p>}
              </div>
            ))
        }
      </div>
    </div>

    <figure class="mt-10 max-w-3xl">
      <img
        src="/assets/images/moving-day.jpg"
        alt="The BioKEA team in the freshly-moved-in Berkeley warehouse — Austin, Sean, and Michelle with baby Cora in a sling"
        width="1200"
        height="900"
        class="w-full rounded-md border border-slate-900/10"
        loading="lazy"
      />
      <figcaption class="mt-3 text-xs text-slate-500 leading-relaxed">
        Move-in day, <time datetime="2026-03">March 2026</time>. Austin, Sean, Michelle — and Cora,
        the team's youngest. The 5,000+ sq ft Berkeley warehouse, newly empty and waiting.
      </figcaption>
    </figure>
  </section>

  <ProgramsStrip variant="expanded" />

  <section class="max-w-6xl mx-auto px-6 py-12">
    <Eyebrow>RECOGNITION</Eyebrow>
    <p class="mt-3 max-w-[62ch] text-slate-600 leading-relaxed">
      Sean Jungbluth was named a winner of Anthropic's
      <a
        href="https://x.com/alexalbert__/status/1978220407716245581"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-slate-400 hover:text-[var(--color-teal)]"
        >Built with Claude Sonnet 4.5 Challenge</a
      > (October 2025) for
      <a href="/projects" class="underline decoration-slate-400 hover:text-[var(--color-teal)]"
        >DaKineDiving</a
      >, a real-time dive intelligence platform for O'ahu. See
      <a href="/press" class="underline decoration-slate-400 hover:text-[var(--color-teal)]"
        >press kit + coverage</a
      >.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <Eyebrow>PARTNERS</Eyebrow>
    <div class="mt-5 flex gap-2 flex-wrap">
      {
        partners.map((p) => (
          <PartnerMark
            name={p.name}
            note={p.note}
            major={p.major}
            url={p.url}
            description={p.description}
          />
        ))
      }
    </div>
    <ul class="mt-5 space-y-2 text-sm text-slate-600 leading-relaxed max-w-[62ch]">
      {
        partners
          .filter((p) => p.description)
          .map((p) => (
            <li>
              <span class="font-semibold text-[var(--color-ink)]">{p.name}</span>
              <span class="text-slate-500"> — </span>
              <span>{p.description}</span>
            </li>
          ))
      }
    </ul>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <Eyebrow>MILESTONES</Eyebrow>
    <div class="mt-6 grid md:grid-cols-[1fr_320px] gap-10 items-start">
      <ol class="space-y-4">
        {
          milestones.map((m) => (
            <li class="grid md:grid-cols-[120px_1fr] gap-4 border-t border-slate-900/10 pt-4">
              <time
                datetime={m.date}
                data-milestone-date
                class="font-mono text-sm text-[var(--color-teal)]"
              >
                {m.date}
              </time>
              <div>
                <p class="font-semibold text-[var(--color-ink)]">{m.title}</p>
                {m.body && <p class="mt-1 text-sm text-slate-600 leading-relaxed">{m.body}</p>}
              </div>
            </li>
          ))
        }
      </ol>
      <figure class="hidden md:block sticky top-24 self-start">
        <img
          src="/assets/images/taxonomic-tree.webp"
          alt="A phylogenetic tree illustration in editorial teal line-art — branching lineage as a visual companion to the BioKEA timeline."
          width="400"
          height="800"
          class="w-full max-w-[320px] ml-auto block opacity-80"
          loading="lazy"
        />
        <figcaption
          class="mt-3 font-mono text-[10px] tracking-[0.14em] uppercase text-slate-500 text-right"
        >
          Fig · branching lineage
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12">
    <Eyebrow>COMMITMENT</Eyebrow>
    <h2 class="mt-3 text-2xl font-semibold max-w-[30ch]">Built for the commons, by design.</h2>
    <p class="mt-3 max-w-[62ch] text-slate-600 leading-relaxed">
      BioKEA's outputs are public goods. The science we publish belongs to the commons; the
      infrastructure that produces it is open by design. We chose FAIR as our output format and AT
      Protocol as our publishing medium because the alternative is a science whose claims you can't
      trust, on infrastructure you can't audit. The science is only as valuable as the trust people
      can place in it.
    </p>
  </section>

  <CtaBand
    title="Fund the work. Or build it with us."
    subtitle="We're in active partnership and funding conversations."
    cta={{ href: '/contact', label: 'Get in touch' }}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={stringifyJsonLd({
      '@context': 'https://schema.org',
      '@graph': team.map((p) => {
        const creds = credentialsFor(p.name);
        const slug = p.name.split(' ')[0].toLowerCase();
        const credentialUrls = creds.filter((c) => c.url).map((c) => c.url!);
        const allSameAs = [...(p.sameAs ?? []), ...credentialUrls];
        const isPlaceholderImage = p.image.endsWith('.svg');
        return {
          '@type': 'Person',
          '@id': `https://biokea.ai/mission#${slug}`,
          name: p.name,
          ...(p.postNominal ? { honorificSuffix: p.postNominal } : {}),
          jobTitle: p.role,
          worksFor: { '@id': 'https://biokea.ai/#org' },
          ...(isPlaceholderImage ? {} : { image: `https://biokea.ai${p.image}` }),
          ...(p.bio ? { description: p.bio } : {}),
          ...(p.knowsAbout && p.knowsAbout.length > 0 ? { knowsAbout: p.knowsAbout } : {}),
          ...(allSameAs.length > 0 ? { sameAs: allSameAs } : {}),
          ...(creds.length > 0
            ? {
                award: creds.map((c) => c.label),
                affiliation: {
                  '@type': 'Organization',
                  name: creds[0].issuer,
                  url: creds[0].issuerUrl,
                },
              }
            : {}),
        };
      }),
    })}
  />
</BaseLayout>
