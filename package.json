{
  "name": "biokea-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-games.mjs && astro build",
    "games:build": "node scripts/build-games.mjs",
    "agentis:previews": "node scripts/capture-agentis-previews.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "prettier --check \"src/**/*.{astro,ts,tsx,md,mdx,css}\"",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,md,mdx,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,md,mdx,json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.0.0",
    "tailwindcss": "^4.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.1",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
