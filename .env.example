# .env.example — copy to .env.local for local dev
RESEND_API_KEY=re_xxx
CONTACT_FROM_EMAIL=notifications@biokea.ai
CONTACT_TO_EMAIL=contact@biokea.ai

# Cloudflare Turnstile — optional. If both are set, the contact form
# renders the widget and the server verifies the token. Leave unset for
# local dev to skip verification.
# Cloudflare test keys (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
